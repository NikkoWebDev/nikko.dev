---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseStudy from "../../components/CaseStudy.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const lang = "es" as const;
const text = {
  title: project.title,
  description: project.description,
  problem: project.problem,
  work: project.work,
  result: project.result,
};
---

<BaseLayout
  title={`${project.title} — Caso de estudio`}
  description={project.description}
  ogImage={project.image}
  lang={lang}
  canonicalPath={`/proyectos/${project.slug}`}
  palette={project.palette}
>
  <CaseStudy project={project} lang={lang} text={text} />
</BaseLayout>
