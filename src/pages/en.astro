---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import SkillsMarquee from "../components/SkillsMarquee.astro";
import Services from "../components/Services.astro";
import Projects from "../components/Projects.astro";
import Impacto from "../components/Impacto.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Metrics from "../components/Metrics.astro";
import Certifications from "../components/Certifications.astro";
import FAQ from "../components/FAQ.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

const lang = "en";
const title = "NikkoDev | Web, AI and Automation · Edge-First Full-Stack";
const description = "Full-Stack Developer specialized in Applied AI, Edge Computing and modern web platforms. Landing pages, AI apps and automation for businesses that want to sell more.";
---

<BaseLayout title={title} description={description} lang="en">
  <Navbar lang={lang} />
  <main>
    <Hero lang={lang} />
    <Metrics lang={lang} />
    <SkillsMarquee />
    <Projects lang={lang} />
    <Impacto lang={lang} />
    <Services lang={lang} />
    <About lang={lang} />
    <Experience lang={lang} />
    <Certifications lang={lang} />
    <FAQ lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer />

  <script is:inline>
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // ── Tiny tween helper (power3.out — same curve as the GSAP it replaces) ──
    const easeOut3 = (t) => 1 - Math.pow(1 - t, 3);
    const tween = (to, dur, cb) => {
      const t0 = performance.now();
      const step = (now) => {
        const p = Math.min((now - t0) / (dur * 1000), 1);
        cb(to * easeOut3(p));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    // ── Run once when an element scrolls into view (replaces ScrollTrigger) ──
    const onVisible = (el, run) => {
      if (!("IntersectionObserver" in window)) { run(); return; }
      const io = new IntersectionObserver((entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            obs.disconnect();
            run();
          }
        });
      }, { threshold: 0.06, rootMargin: "0px 0px -30px 0px" });
      io.observe(el);
    };

    // ── Counter display: preserves "k+", locale grouping and suffixes ──
    const writeCount = (el, val, isK, finalNum, suffix) => {
      if (isK) {
        el.textContent = (val / 1000).toFixed(0) + "k+";
      } else if (finalNum >= 1000) {
        el.textContent = Math.round(val).toLocaleString() + suffix;
      } else {
        el.textContent = Math.round(val) + suffix;
      }
    };
    const animateCounter = (el, target, suffix = "") => {
      const num = parseFloat(String(target).replace(/[^0-9.]/g, ""));
      const isK = String(target).includes("k");
      const finalNum = isK ? num * 1000 : num;
      if (prefersReducedMotion || finalNum === 0) {
        writeCount(el, finalNum, isK, finalNum, suffix);
        return;
      }
      onVisible(el, () => {
        writeCount(el, 0, isK, finalNum, suffix);
        tween(finalNum, 2, (val) => {
          writeCount(el, val, isK, finalNum, suffix);
        });
      });
    };

    // ── Animate numeric values in dash-cards ──
    document.querySelectorAll(".dash-num").forEach((el) => {
      const text = el.textContent.trim();
      if (!text || text === "Edge" || text === "B2" || text === "~$0" || text === "13" || text === "2") return;
      const parsed = parseFloat(text);
      if (isNaN(parsed) || el.dataset.count) return;
      animateCounter(el, text);
    });

    // ── Scroll Reveal (IntersectionObserver) ──
    (() => {
      if (prefersReducedMotion) return;

      const selectors = [
        ".exp-body", ".faq-item", ".hm-item",
        ".contact-box", ".about-terminal",
        ".exam-card", ".section-head",
        ".term-log", ".dash-gauge", ".about-quote",
        ".about-footer",
        // Cards formerly tweened with GSAP; same reveal system, no stagger
        ".serv-card", ".project-card", ".dash-card", ".cert-card", ".about-hl",
        ".impact-panel", ".impact-metric",
      ];
      const isCard = (el) => el.matches(".serv-card, .project-card, .dash-card, .cert-card, .about-hl");

      const elements = document.querySelectorAll(selectors.join(","));

      elements.forEach((el, i) => {
        el.classList.add("reveal");
        if (isCard(el)) {
          el.style.setProperty("--reveal-delay", "0s");
        } else if (el.closest(".dash-grid") || el.closest(".exp-list") || el.closest(".projects-list")) {
          const parent = el.closest(".dash-grid") || el.closest(".exp-list") || el.closest(".projects-list");
          const siblings = Array.from(parent?.querySelectorAll(".dash-card, .exp-item, .project-card") || [el]);
          const idx = siblings.indexOf(el);
          el.style.setProperty("--reveal-delay", `${(idx * 0.06).toFixed(2)}s`);
        } else {
          el.style.setProperty("--reveal-delay", `${(i * 0.03) % 0.3}s`);
        }
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.06, rootMargin: "0px 0px -30px 0px" });

      elements.forEach((el) => observer.observe(el));
    })();

    // ── Dynamic dash-card value animation (IO + rAF) ──
    (() => {
      const dashNum = document.querySelector('.dash-featured .dash-num');
      if (!dashNum || !dashNum.dataset.count) return;
      const target = parseInt(dashNum.dataset.count, 10);
      if (prefersReducedMotion) {
        dashNum.textContent = String(target);
        return;
      }
      onVisible(dashNum.closest('.dash-card') || dashNum, () => {
        dashNum.textContent = "0";
        tween(target, 2, (val) => {
          dashNum.textContent = String(Math.round(val));
        });
      });
    })();
  </script>

  <style is:global>
    html.js .reveal {
      opacity: 0 !important;
      transform: translateY(24px) !important;
      transition: opacity 0.7s cubic-bezier(0.22, 0.7, 0.2, 1),
                  transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) !important;
      transition-delay: var(--reveal-delay, 0s) !important;
    }
    html.js .reveal.visible {
      opacity: 1 !important;
      transform: translateY(0) !important;
    }
    .typo-line {
      opacity: 0;
      animation: typoIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: var(--typo-delay, 0s);
    }
    @keyframes typoIn {
      from { opacity: 0; transform: translateX(-6px); }
      to { opacity: 1; transform: translateX(0); }
    }
    .section-head.reveal,
    .section-head-compact.reveal {
      transform: translateY(16px) !important;
    }
    .section-head.reveal.visible,
    .section-head-compact.reveal.visible {
      transform: translateY(0) !important;
    }
    @media (prefers-reduced-motion: reduce) {
      html.js .reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
      .typo-line { opacity: 1; animation: none; }
    }
  </style>
</BaseLayout>
