---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CaseStudy from "../../../components/CaseStudy.astro";
import { projects } from "../../../data/projects";

const copy = {
  fibog: {
    title: "FIBOG Seedbeds — Universidad Nacional de Colombia",
    description: "A platform to centralize research groups and seedbeds.",
    problem: "The faculty had no place to centralize its research groups and seedbeds. Information was spread across emails, PDFs and WhatsApp groups.",
    work: "We built a platform with Astro, Supabase and PostgreSQL: group catalog, role management and application forms.",
    result: "A production platform managing 13 groups.",
  },
  sinpresupuesto: {
    title: "SinPresupuesto",
    description: "An educational platform for students without resources.",
    problem: "The foundation works to reduce limited access to pre-university education for students who need quality material.",
    work: "We implemented Microsoft and Google OAuth, a PWA for offline use and a Llama 3.1 chatbot on Edge infrastructure.",
    result: "A functional platform with multi-layer authentication, a Llama 3.1 chatbot and Edge infrastructure.",
  },
  ceis: {
    title: "CEIS — Systems Engineering Student Council | UNAL",
    description: "Official institutional platform for the Systems Engineering Student Council.",
    problem: "Hundreds of Systems Engineering students lacked a centralized, transparent hub to explore their interactive curriculum, join commissions, and communicate with student representatives.",
    work: "Co-developed, as one of the two lead developers, a high-performance Single Page Application with React, Vite, Tailwind CSS and Supabase for serverless backend persistence, with zero-flash dark/light theming.",
    result: "Official institutional platform in production at https://ceis-unal.com, serving the student community of Universidad Nacional de Colombia.",
  },
  reprebot: {
    title: "Reprebot — Fine-tuned AI for UNAL",
    description: "Qwen 3.5 (4B) fine-tune for UNAL with its own API, deployed on WhatsApp, CEIS chat and forum.",
    problem: "Dozens of repetitive queries about academic regulations and procedures arrived daily via WhatsApp and forums without the human capacity to respond in real time.",
    work: "A Qwen 3.5 (4B) fine-tune on UNAL regulations with a RAG engine over official sources, a dedicated API with streaming, and multi-channel deployment: WhatsApp, CEIS chat and forum, with answers that cite their sources.",
    result: "Live chat at https://repre.nikko.dev and production API, answering regulations with cited sources across all three CEIS channels.",
  },
  autorreparacion: {
    title: "Autorreparación",
    description: "A landing page for a real vehicle repair business.",
    problem: "A vehicle repair business needed a real digital presence: something that could appear on Google and generate contacts.",
    work: "I built an Astro landing page with GSAP, technical SEO, responsive design and a direct WhatsApp CTA.",
    result: "A functional digital presence, basic SEO and WhatsApp conversions.",
  },
  indusec: {
    title: "InduSEC",
    description: "A landing page for an automatic doors company.",
    problem: "An automatic doors company had no professional web presence and needed to build trust in local searches.",
    work: "I built an Astro landing page focused on SEO, responsive design and a clean commercial presentation.",
    result: "A live, functional site for a physical business that needed to go digital.",
  },
} as const;

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const lang = "en" as const;
const text = copy[project.slug as keyof typeof copy];
---

<BaseLayout
  title={`${text.title} — Case study`}
  description={text.description}
  ogImage={project.image}
  lang={lang}
  canonicalPath={`/en/projects/${project.slug}`}
  palette={project.palette}
>
  <CaseStudy project={project} lang={lang} text={text} />
</BaseLayout>
