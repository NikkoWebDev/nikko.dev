---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import { projects } from "../../../data/projects";

const copy = {
  fibog: {
    title: "FIBOG Seedbeds — Universidad Nacional de Colombia",
    description: "A platform to centralize research groups and seedbeds.",
    problem: "The faculty had no place to centralize its research groups and seedbeds. Information was spread across emails, PDFs and WhatsApp groups.",
    work: "We built a platform with Astro, Supabase and PostgreSQL: group catalog, role management and application forms.",
    result: "A production platform managing 13 groups.",
  },
  sinpresupuesto: {
    title: "SinPresupuesto",
    description: "An educational platform for students without resources.",
    problem: "The foundation works to reduce limited access to pre-university education for students who need quality material.",
    work: "We implemented Microsoft and Google OAuth, a PWA for offline use and a Llama 3.1 chatbot on Edge infrastructure.",
    result: "A functional platform with multi-layer authentication, a Llama 3.1 chatbot and Edge infrastructure.",
  },
  autorreparacion: {
    title: "Autorreparación",
    description: "A landing page for a real vehicle repair business.",
    problem: "A vehicle repair business needed a real digital presence: something that could appear on Google and generate contacts.",
    work: "I built an Astro landing page with GSAP, technical SEO, responsive design and a direct WhatsApp CTA.",
    result: "A functional digital presence, basic SEO and WhatsApp conversions.",
  },
  indusec: {
    title: "InduSEC",
    description: "A landing page for an automatic doors company.",
    problem: "An automatic doors company had no professional web presence and needed to build trust in local searches.",
    work: "I built an Astro landing page focused on SEO, responsive design and a clean commercial presentation.",
    result: "A live, functional site for a physical business that needed to go digital.",
  },
} as const;

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const lang = "en" as const;
const text = copy[project.slug as keyof typeof copy];
const title = `${text.title} — Case study`;
const whatsapp = "https://wa.me/573136638097";
---

<BaseLayout title={title} description={text.description} ogImage={project.image} lang={lang} canonicalPath={`/en/projects/${project.slug}`}>
  <Navbar lang={lang} />
  <main>
    <div class="container case">
      <a class="case-back" href="/en#proyectos">← Back to projects</a>

      <header class="case-head">
        <div class="eyebrow">// case study</div>
        <h1>{text.title}</h1>
        <p class="section-sub">{text.description}</p>
      </header>

      <figure class="case-cover">
        <img
          src={project.image}
          alt={`Screenshot of ${text.title}`}
          width="1280"
          height="800"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="case-grid">
        <article class="card">
          <p class="case-label">01 · The problem</p>
          <h2>Context</h2>
          <p>{text.problem}</p>
        </article>
        <article class="card">
          <p class="case-label">02 · What I did</p>
          <h2>Implementation</h2>
          <p>{text.work}</p>
        </article>
        <article class="card">
          <p class="case-label">03 · Result</p>
          <h2>Status</h2>
          <p>{text.result}</p>
        </article>
        <article class="card">
          <p class="case-label">04 · Stack</p>
          <h2>Tools</h2>
          <div class="case-tags">
            {project.stack.map((item) => <span class="tag">{item}</span>)}
          </div>
        </article>
      </div>

      <div class="case-actions">
        <a class="btn btn-primary" href={project.demo} target="_blank" rel="noopener noreferrer">
          View demo ↗
        </a>
        {project.repo && (
          <a class="btn" href={project.repo} target="_blank" rel="noopener noreferrer">
            View repository ↗
          </a>
        )}
        <a class="btn" href={whatsapp} target="_blank" rel="noopener noreferrer">
          Let's talk on WhatsApp ↗
        </a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .case {
    padding-top: 120px;
    padding-bottom: 80px;
  }

  .case-back {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--accent-text);
    text-decoration: none;
    margin-bottom: 28px;
  }

  .case-back:hover { text-decoration: underline; }

  .case-head {
    max-width: 760px;
    margin-bottom: 32px;
  }

  .case-head h1 {
    font-size: clamp(1.8rem, 4.4vw, 3rem);
    line-height: 1.06;
    letter-spacing: -0.045em;
    margin: 10px 0 14px;
  }

  .case-cover {
    margin: 0 0 44px;
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--surface);
  }

  /* The screenshots are full-page (up to 12946px tall): show them cropped
     from the top, never at full height. */
  .case-cover img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
  }

  .case-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .case-grid h2 {
    font-size: 1.15rem;
    margin: 8px 0 10px;
    letter-spacing: -0.02em;
  }

  .case-grid p {
    color: var(--muted);
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .case-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-2-text) !important;
  }

  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .case-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  @media (max-width: 720px) {
    .case { padding-top: 100px; }
    .case-grid { grid-template-columns: 1fr; }
    .case-actions { flex-direction: column; }
    .case-actions .btn { text-align: center; }
  }
</style>
