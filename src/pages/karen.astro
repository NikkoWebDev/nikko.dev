---
// src/pages/karen/index.astro
// Página privada — no enlazada desde el nav ni el sitemap.
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Karen</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="glow" id="glow"></div>

    <main>
      <header class="opening">
        <p class="eyebrow">para Karen</p>
        <h1>mi boxeadora favorita,<br /><em>la luz de mis días.</em></h1>
      </header>

      <section class="letter">
        <p class="line" data-line>
          Amo cómo tú llegaste a mi vida de repente y me hiciste tan
          feliz.
        </p>
        <p class="line" data-line>
          Me gusta cada cosa de ti: tus ojos tan claros como dos estrellas,
          tu pelo ondulado que es una hipnótica espiral, y cómo eres capaz
          de alegrarme cada día aunque pueda estar super mal.
        </p>
        <p class="line" data-line>
          Amo caminar de la mano contigo, me encanta abrazarte y admirarte
          como si fueras un lindo atardecer.
        </p>

        <p class="line quote" data-line>
          Platón alguna vez dijo algo como:
          <span class="quote-text"
            >el amor es la magia que nos vuelve poetas, el gusto de encender
            una luz en el alma del otro y el compromiso de no dejarla
            apagar.</span
          >
        </p>
        <p class="line" data-line>
          Y es aquel compromiso el que me gustaría mantener junto a ti por
          toda la eternidad — hacer que esta luz en tu alma no vaya a ser
          fugaz, y poder estar juntos hasta el final, si es que hay alguno.
        </p>

        <p class="line" data-line>
          ¿Sabes cómo adoro ir de la mano contigo? Es algo inexplicable,
          siento que tengo una razón de existir, un ancla a la realidad,
          se siente como eres mi motivo para seguir un dia mas.
        </p>
        <p class="line" data-line>
          O aquel día que estaba tan mal, y aun así conseguiste hacerme
          feliz. Ese es el tipo de cosas que me hicieron quererte a ti.
          
          Perdoname, porque tal vez me cuesta expresarte las cosas,
          se que soy raro y no se si eso pueda molestarte, 
          amaria estar juntos hasta el final y 
          que lo que siento no solo sea algo fugaz, 
          porque te quiero demasiado como para dejarte ir 
          y lo suficiente para mejorar por ti,

          soy solo un loco que te quiere y espera llevar su vida a tu lado.
        </p>
        <p class="line signature" data-line>
          Te amo, y mucho más de lo que consigo expresarte.
        </p>
      </section>

      <!-- Curva del corazón: ecuación paramétrica real -->
      <section class="heart-section" data-line>
        <p class="heart-caption">
          la matematica lo expresa mejor que yo:

          <code>(16sin³t, 13cos t − 5cos2t − 2cos3t − cos4t)</code>
        </p>
        <svg
          id="heart-svg"
          viewBox="-20 -20 40 36"
          class="heart-svg"
          aria-hidden="true"
        >
          <path id="heart-path" fill="none" stroke="url(#heartGrad)" stroke-width="0.6" />
          <defs>
            <linearGradient id="heartGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#c9a15a" />
              <stop offset="100%" stop-color="#8a2846" />
            </linearGradient>
          </defs>
        </svg>
      </section>

      <!-- Cierre interactivo -->
      <section class="finale" data-line>
        <button id="pulse-btn" class="pulse-btn" aria-label="Mantén presionado">
          <span class="pulse-ring"></span>
          <span class="pulse-label">mantén presionado</span>
        </button>
        <p class="finale-text" id="finale-text">
          para dejar la luz encendida.
        </p>
      </section>

      <!-- Easter egg matemático -->
      <footer class="closing">
        <div class="equation" id="equation" tabindex="0">
          <span class="eq-part eq-i">
            √(−1)<span class="eq-tooltip">i = √(−1)</span>
          </span>
          <svg class="eq-heart" viewBox="0 0 32 29" width="1em" height="1em">
            <path
              d="M16 28C16 28 2 18.5 2 9.5C2 4.8 5.8 1 10.5 1C13 1 15.2 2.2 16 4.2C16.8 2.2 19 1 21.5 1C26.2 1 30 4.8 30 9.5C30 18.5 16 28 16 28Z"
              fill="var(--wine)"
            />
          </svg>
          <span class="eq-part eq-u">
            u<span class="eq-tooltip">u = tú</span>
          </span>
        </div>
        <span class="mark">✦</span>
      </footer>
    </main>

    <script>
      const glow = document.getElementById("glow");
      const lines = document.querySelectorAll<HTMLElement>("[data-line]");

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("lit");
              const rect = entry.target.getBoundingClientRect();
              const y = rect.top + rect.height / 2 + window.scrollY;
              if (glow) glow.style.top = `${y}px`;
            }
          });
        },
        { threshold: 0.5 }
      );

      lines.forEach((line) => io.observe(line));

      // --- Curva cardioide paramétrica real ---
      const heartPath = document.getElementById("heart-path");
      if (heartPath) {
        const steps = 200;
        let d = "";
        for (let i = 0; i <= steps; i++) {
          const t = (i / steps) * Math.PI * 2;
          const x = 16 * Math.pow(Math.sin(t), 3);
          const y = -(
            13 * Math.cos(t) -
            5 * Math.cos(2 * t) -
            2 * Math.cos(3 * t) -
            Math.cos(4 * t)
          );
          d += `${i === 0 ? "M" : "L"} ${x.toFixed(2)} ${(y / 1.6).toFixed(2)} `;
        }
        d += "Z";
        heartPath.setAttribute("d", d);

        // Animación de trazo al entrar en viewport
        const length = (heartPath as SVGPathElement).getTotalLength();
        heartPath.style.strokeDasharray = `${length}`;
        heartPath.style.strokeDashoffset = `${length}`;

        const heartIo = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                (heartPath as HTMLElement).style.transition =
                  "stroke-dashoffset 2.2s cubic-bezier(0.65,0,0.35,1)";
                (heartPath as HTMLElement).style.strokeDashoffset = "0";
              }
            });
          },
          { threshold: 0.5 }
        );
        heartIo.observe(document.getElementById("heart-svg")!);
      }

      // --- Botón de cierre: mantener presionado ---
      const btn = document.getElementById("pulse-btn");
      const finaleText = document.getElementById("finale-text");
      let holdTimer: number | null = null;

      const activate = () => {
        btn?.classList.add("held");
      };
      const complete = () => {
        if (btn?.classList.contains("held")) {
          btn.classList.add("done");
          finaleText?.classList.add("revealed");
          if (glow) {
            glow.classList.add("settled");
            const rect = btn.getBoundingClientRect();
            glow.style.top = `${rect.top + window.scrollY}px`;
          }
        }
      };
      const cancel = () => {
        if (btn && !btn.classList.contains("done")) {
          btn.classList.remove("held");
        }
        if (holdTimer) window.clearTimeout(holdTimer);
      };

      btn?.addEventListener("pointerdown", () => {
        activate();
        holdTimer = window.setTimeout(complete, 1100);
      });
      btn?.addEventListener("pointerup", cancel);
      btn?.addEventListener("pointerleave", cancel);

      // --- Easter egg: click revela la "demostración" ---
      const eq = document.getElementById("equation");
      eq?.addEventListener("click", () => {
        eq.classList.toggle("expanded");
      });
    </script>

    <style>
      :root {
        --bg: #0f0b0d;
        --ink: #f2e9e4;
        --ink-dim: #cbb9b3;
        --wine: #8a2846;
        --gold: #c9a15a;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "Inter", sans-serif;
        overflow-x: hidden;
      }

      @media (prefers-reduced-motion: no-preference) {
        html {
          scroll-behavior: smooth;
        }
      }

      .glow {
        position: absolute;
        left: 50%;
        top: 40vh;
        width: 900px;
        height: 900px;
        transform: translate(-50%, -50%);
        background: radial-gradient(
          circle,
          rgba(201, 161, 90, 0.16) 0%,
          rgba(138, 40, 70, 0.1) 40%,
          transparent 70%
        );
        filter: blur(20px);
        pointer-events: none;
        transition: top 0.9s cubic-bezier(0.22, 1, 0.36, 1);
        z-index: 0;
      }

      .glow.settled {
        transition: top 1.4s cubic-bezier(0.22, 1, 0.36, 1), opacity 1.4s ease;
      }

      main {
        position: relative;
        z-index: 1;
        max-width: 560px;
        margin: 0 auto;
        padding: 14vh 1.5rem 16vh;
      }

      .opening {
        text-align: center;
        margin-bottom: 16vh;
      }

      .eyebrow {
        font-family: "Inter", sans-serif;
        font-size: 0.75rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--gold);
        margin: 0 0 1.5rem;
      }

      h1 {
        font-family: "Cormorant Garamond", serif;
        font-weight: 600;
        font-size: clamp(2rem, 6vw, 3.2rem);
        line-height: 1.25;
        margin: 0;
        color: var(--ink);
      }

      h1 em {
        font-style: italic;
        color: var(--wine);
        background: linear-gradient(90deg, var(--wine), var(--gold));
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .letter {
        display: flex;
        flex-direction: column;
        gap: 9vh;
      }

      .line {
        font-family: "Cormorant Garamond", serif;
        font-size: clamp(1.15rem, 2.6vw, 1.5rem);
        line-height: 1.75;
        color: var(--ink-dim);
        opacity: 0;
        transform: translateY(14px);
        transition: opacity 1s ease, transform 1s ease, color 1s ease;
      }

      .line.lit {
        opacity: 1;
        transform: translateY(0);
        color: var(--ink);
      }

      .quote {
        padding-left: 1.25rem;
        border-left: 1px solid var(--wine);
      }

      .quote-text {
        font-style: italic;
        color: var(--gold);
      }

      .signature {
        text-align: center;
        font-style: italic;
        font-size: clamp(1.3rem, 3vw, 1.7rem);
      }

      /* --- Corazón paramétrico --- */
      .heart-section {
        margin-top: 18vh;
        text-align: center;
        opacity: 0;
        transform: translateY(14px);
        transition: opacity 1s ease, transform 1s ease;
      }
      .heart-section.lit {
        opacity: 1;
        transform: translateY(0);
      }

      .heart-caption {
        font-family: "JetBrains Mono", monospace;
        font-size: 0.7rem;
        color: var(--ink-dim);
        letter-spacing: 0.02em;
        margin: 0 0 1.5rem;
      }

      .heart-caption code {
        color: var(--gold);
        background: none;
      }

      .heart-svg {
        width: min(70vw, 260px);
        height: auto;
        overflow: visible;
      }

      /* --- Cierre interactivo --- */
      .finale {
        margin-top: 18vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
        opacity: 0;
        transform: translateY(14px);
        transition: opacity 1s ease, transform 1s ease;
      }
      .finale.lit {
        opacity: 1;
        transform: translateY(0);
      }

      .pulse-btn {
        position: relative;
        width: 84px;
        height: 84px;
        border-radius: 50%;
        border: 1px solid var(--wine);
        background: rgba(138, 40, 70, 0.08);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        touch-action: none;
        transition: transform 0.2s ease, background 0.4s ease;
      }

      .pulse-btn::before {
        content: "";
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--gold);
        transition: transform 1.1s ease, background 0.4s ease;
      }

      .pulse-btn.held::before {
        transform: scale(2.4);
      }

      .pulse-btn.held {
        transform: scale(0.94);
      }

      .pulse-btn.done {
        background: rgba(201, 161, 90, 0.18);
        border-color: var(--gold);
      }

      .pulse-btn.done::before {
        background: var(--gold);
        transform: scale(1);
        box-shadow: 0 0 24px 6px rgba(201, 161, 90, 0.55);
      }

      .pulse-ring {
        position: absolute;
        inset: -1px;
        border-radius: 50%;
        border: 1px solid var(--wine);
        opacity: 0;
      }

      .pulse-btn.held .pulse-ring {
        animation: ring 1.1s ease forwards;
      }

      @keyframes ring {
        0% {
          opacity: 0.6;
          transform: scale(1);
        }
        100% {
          opacity: 0;
          transform: scale(1.8);
        }
      }

      .pulse-label {
        position: absolute;
        top: 100px;
        font-family: "Inter", sans-serif;
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-dim);
        white-space: nowrap;
      }

      .finale-text {
        font-family: "Cormorant Garamond", serif;
        font-style: italic;
        font-size: 1.2rem;
        color: var(--gold);
        opacity: 0;
        transition: opacity 1s ease;
        margin: 2.5rem 0 0;
      }

      .finale-text.revealed {
        opacity: 1;
      }

      /* --- Footer + easter egg --- */
      .closing {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        margin-top: 12vh;
      }

      .equation {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-family: "Cormorant Garamond", serif;
        font-size: 1.6rem;
        font-style: italic;
        color: var(--ink-dim);
        cursor: pointer;
        user-select: none;
      }

      .eq-part {
        position: relative;
      }

      .eq-tooltip {
        position: absolute;
        bottom: 140%;
        left: 50%;
        transform: translateX(-50%) translateY(4px);
        font-family: "JetBrains Mono", monospace;
        font-style: normal;
        font-size: 0.65rem;
        color: var(--gold);
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease, transform 0.3s ease;
      }

      .equation.expanded .eq-tooltip {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }

      .eq-heart {
        display: block;
      }

      .mark {
        color: var(--wine);
        font-size: 1.2rem;
        opacity: 0.6;
      }

      @media (prefers-reduced-motion: reduce) {
        .line,
        .heart-section,
        .finale {
          transition: none;
          opacity: 1;
          transform: none;
        }
        .glow {
          transition: none;
        }
        #heart-path {
          transition: none !important;
          stroke-dashoffset: 0 !important;
        }
      }
    </style>
  </body>
</html>
