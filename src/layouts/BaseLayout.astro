---
import "../styles/global.css";
import CommandPalette from "../components/CommandPalette.astro";
import { PERSON } from "../data/site";
import { alternatePath, useTranslations, type Lang } from "../i18n/utils";
import { absoluteUrl, organizationSchema, personSchema, serializeGraph, webPageSchema, websiteSchema, type SchemaNode } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Ruta de esta página (/, /en, /proyectos/fibog…): canonical, hreflang y paleta salen de aquí. */
  path: string;
  ogImage?: string;
  ogType?: "website" | "article";
  /** Nodos JSON-LD propios de la página (FAQ, caso de estudio, migas…). */
  schema?: SchemaNode[];
  noindex?: boolean;
}

const { title, description, lang, path, ogImage = "/og-image.png", ogType = "website", schema = [], noindex = false } = Astro.props;
const t = useTranslations(lang);

const canonical = absoluteUrl(path);
const esUrl = absoluteUrl(alternatePath(path, "es"));
const enUrl = absoluteUrl(alternatePath(path, "en"));
const ogImageUrl = absoluteUrl(ogImage);
const jsonLd = serializeGraph([
  personSchema(lang),
  organizationSchema(lang),
  websiteSchema(),
  webPageSchema({ url: canonical, name: title, description, lang }),
  ...schema,
]);
---

<!doctype html>
<html lang={lang} class="dark" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={PERSON.name} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" id="themeColor" content="#050B0A" />
    <meta name="application-name" content="NikkoDev OS" />
    <meta name="generator" content="Astro" />
    <meta name="geo.region" content="CO" />
    <meta name="geo.placename" content="Bogotá, Colombia" />

    <!-- Tema antes de pintar: oscuro por defecto, claro solo si el visitante lo eligió. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add("js");
        try {
          if (localStorage.getItem("nikkodev-theme") === "light") {
            root.classList.remove("dark");
            root.classList.add("light");
            root.dataset.theme = "light";
            var meta = document.getElementById("themeColor");
            if (meta) meta.setAttribute("content", "#F4FAF7");
          }
        } catch (e) {}
      })();
    </script>

    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="es" href={esUrl} />}
    {!noindex && <link rel="alternate" hreflang="en" href={enUrl} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={esUrl} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="NikkoDev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={t("meta.og.alt")} />
    <meta property="og:locale" content={t("meta.locale")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:site" content="@NikkoWebDev" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <script type="application/ld+json" set:html={jsonLd}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t("a11y.skip")}</a>
    <div class="page-progress" aria-hidden="true"></div>
    <slot />
    <CommandPalette lang={lang} path={path} />
    <div class="toast" id="toast" role="status" aria-live="polite" aria-atomic="true"></div>
    <script>
      import "../scripts/app";
    </script>
  </body>
</html>
