---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Brayan Nikolas Gallo León" />
  <meta name="theme-color" id="themeColor" content="#F0FDF6" />
  <meta name="robots" content="index, follow" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta name="generator" content="Astro" />
  <meta name="application-name" content="NikkoDev OS" />

  <!-- Geo / Local SEO -->
  <meta name="geo.region" content="CO" />
  <meta name="geo.placename" content="Bogotá, Colombia" />

  <!-- Theme initialization — resuelve localStorage y, si no hay elección, el sistema.
       Corre antes de pintar para que no haya flash ni salto de tema. -->
  <script is:inline>
    (function () {
      try {
        var stored = localStorage.getItem('nikkodev-theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = stored === 'dark' || stored === 'light' ? stored : (prefersDark ? 'dark' : 'light');
        var root = document.documentElement;
        root.classList.add('js');
        root.classList.toggle('dark', theme === 'dark');
        root.classList.toggle('light', theme === 'light');
        root.dataset.theme = theme;
        var meta = document.getElementById('themeColor');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#040816' : '#F0FDF6');
      } catch (e) {
        document.documentElement.classList.add('light');
      }
    })();
  </script>

  <!-- Open Graph -->
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:type" content="website" />
   <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={lang === "en" ? "NikkoDev — AI-powered web development: fast, beautiful and optimized" : "NikkoDev — Desarrollo web con IA: rápido, hermoso y optimizado"} />
   <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="NikkoDev" />
  <meta property="og:locale" content={lang === "es" ? "es_CO" : "en_US"} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={ogDescription} />
   <meta name="twitter:image" content={ogImageUrl} />
   <meta name="twitter:image:alt" content={lang === "en" ? "NikkoDev — Web development, AI and automation" : "NikkoDev — Desarrollo web, IA y automatización"} />
  <meta name="twitter:site" content={twitterHandle} />
  <meta name="twitter:creator" content={twitterHandle} />

  <!-- Canonical + Hreflang -->
   <link rel="canonical" href={canonicalUrl} />
   <link rel="alternate" hreflang="es" href={hreflangEs} />
  <link rel="alternate" hreflang="en" href={hreflangEn} />
  <link rel="alternate" hreflang="x-default" href={SITE} />

  <!-- Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/favicon.svg" />

  <!-- Preconnects for performance -->
  <link rel="dns-prefetch" href="https://wa.me" />
  <link rel="dns-prefetch" href="https://github.com" />
  <link rel="dns-prefetch" href="https://www.linkedin.com" />

  <!-- JSON-LD -->
  <script type="application/ld+json" data-schema="nikkodev" set:html={JSON.stringify(jsonLd)}></script>

  <style is:global>
    /* Critical inline CSS — Obsidian & Zinc */
    :root { --bg-fallback: #F8FAFC; --white-fallback: #0F172A; --font-fallback: "Inter", -apple-system, BlinkMacSystemFont, sans-serif; }
    :root.light, html.light { --bg-fallback: #F8FAFC; --white-fallback: #0F172A; }
    :root.dark, html.dark { --bg-fallback: #09090B; --white-fallback: #F4F4F5; }
    body { background-color: var(--bg-fallback); color: var(--white-fallback); font-family: var(--font-fallback); }
    html.dark body { background-color: #09090B !important; color: #F4F4F5 !important; }
  </style>
</head>
<body>
  <!-- Page loading progress bar -->
  <div class="page-progress" id="pageProgress"></div>
  
  <slot />

  <script>
    import { track } from '../lib/analytics';

    // ── Page Progress Bar + scroll depth ──
    (() => {
      const bar = document.getElementById('pageProgress');
      if (!bar) return;
      let ticking = false;
      // Dispara scroll_25/50/75/100 una sola vez cada uno, reusando el
      // mismo listener de scroll del progress bar (sin duplicar lógica).
      const depthFired = new Set();
      const checkDepth = (progress) => {
        [25, 50, 75, 100].forEach((mark) => {
          if (progress >= mark && !depthFired.has(mark)) {
            depthFired.add(mark);
            track(`scroll_${mark}`);
          }
        });
      };
      const update = () => {
        const scroll = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scroll / docHeight) * 100 : 0;
        bar.style.width = Math.min(progress, 100) + '%';
        checkDepth(progress);
        ticking = false;
      };
      window.addEventListener('scroll', () => {
        if (!ticking) { requestAnimationFrame(update); ticking = true; }
      });
      update();
    })();

    // ── Status Bar Clock ──
    (() => {
      const el = document.getElementById('sbTime');
      if (!el) return;
      const pad = (n) => String(n).padStart(2, '0');
      const tick = () => {
        const d = new Date();
        el.textContent = `${pad(d.getHours())}:${pad(d.getMinutes())}`;
      };
      tick();
      setInterval(tick, 30000);
    })();

    // ── Cursor Glow ── (una escritura por frame, y apagado en táctil o reduced-motion)
    (() => {
      const glow = document.getElementById('cursorGlow');
      if (!glow) return;
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!finePointer || reduceMotion) {
        glow.style.display = 'none';
        return;
      }
      let timer: ReturnType<typeof setTimeout> | undefined;
      let rafId: number | null = null;
      let lastEvent: MouseEvent | null = null;
      const show = () => {
        glow.classList.add('active');
        clearTimeout(timer);
        timer = setTimeout(() => glow.classList.remove('active'), 2000);
      };
      const render = () => {
        rafId = null;
        if (!lastEvent) return;
        glow.style.setProperty('--cx', lastEvent.clientX + 'px');
        glow.style.setProperty('--cy', lastEvent.clientY + 'px');
        show();
      };
      document.addEventListener('mousemove', (e) => {
        lastEvent = e;
        if (rafId === null) rafId = requestAnimationFrame(render);
      }, { passive: true });
    })();

    // ── Analítica: clicks delegados con [data-track] ──
    // Un solo listener para toda la página; los elementos marcan el evento
    // con data-track="nombre" y props opcionales data-track-prop-<clave>.
    (() => {
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        const el = target ? target.closest<HTMLElement>('[data-track]') : null;
        if (!el) return;
        const name = el.getAttribute('data-track');
        if (!name) return;
        const props = Object.create(null);
        for (const attr of el.attributes) {
          if (attr.name.startsWith('data-track-prop-')) {
            props[attr.name.slice('data-track-prop-'.length)] = attr.value;
          }
        }
        track(name, props);
      });
    })();
  </script>
</body>
</html>
