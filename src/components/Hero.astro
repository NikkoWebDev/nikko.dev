---
import { getTranslation, type Lang } from "../data/translations";

export interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
---

<section class="hero-section">
  <div class="container hero-inner">
    <div class="hero-content">
      <div class="hero-badge">
        <span class="pulse-dot"></span>
        {getTranslation("hero.badge", lang)}
      </div>

      <div class="hero-prompt">
        {getTranslation("hero.prompt", lang)}<span class="cursor"></span>
      </div>

      <h1>
        {getTranslation("hero.title.line1", lang)}
        <span class="gradient-text">{getTranslation("hero.title.line2", lang)}</span>
      </h1>

      <p class="hero-desc" set:html={getTranslation("hero.desc", lang)}></p>
      <p class="hero-loc">{getTranslation("hero.loc", lang)}</p>

      <div class="hero-actions">
        <a class="btn-wa" href="https://wa.me/573136638097" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          {getTranslation("hero.cta.whatsapp", lang)}
        </a>
        <a class="btn-secondary" href="#proyectos">{getTranslation("hero.cta.projects", lang)}</a>
      </div>
    </div>

    <div class="hero-code">
      <div class="hero-code-header">
        <span class="code-dot red"></span>
        <span class="code-dot yellow"></span>
        <span class="code-dot green"></span>
        <span class="hero-code-title">{getTranslation("hero.code.title", lang)}</span>
      </div>
      <div class="hero-code-body">
        <div><span class="code-keyword">export default</span> {'{'}</div>
        <div>&nbsp;&nbsp;<span class="code-prop">name</span>: <span class="code-string">"{getTranslation("hero.code.name", lang)}"</span>,</div>
        <div>&nbsp;&nbsp;<span class="code-prop">alias</span>: <span class="code-string">"{getTranslation("hero.code.alias", lang)}"</span>,</div>
        <div>&nbsp;&nbsp;<span class="code-prop">role</span>: <span class="code-string">"{getTranslation("hero.code.role", lang)}"</span>,</div>
        <div>&nbsp;&nbsp;<span class="code-prop">obsession</span>: <span class="code-string">"{getTranslation("hero.code.obsession", lang)}"</span>,</div>
        <div>&nbsp;&nbsp;<span class="code-prop">status</span>: <span class="code-string">"available"</span></div>
        <div>{'}'}</div>
        <div style="margin-top: 0.5rem;"><span class="code-comment">// {getTranslation("hero.code.comment", lang)}</span></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 0;
    display: flex;
    align-items: center;
    padding: 112px 0 96px;
    position: relative;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
    width: min(var(--max), calc(100% - 48px));
    margin-inline: auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    background: rgba(255,255,255,0.72);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(16,185,129,0.18);
    border-radius: var(--radius-full);
    font-family: var(--mono);
    font-size: 0.78rem;
    color: #059669;
    font-weight: 600;
    margin-bottom: 20px;
    box-shadow: 0 4px 16px rgba(16,185,129,0.08);
  }

  .hero-badge .pulse-dot {
    width: 6px;
    height: 6px;
    background: var(--green-wa);
    box-shadow: none;
    animation: pulse 2s infinite;
  }

  .hero-prompt {
    font-family: var(--mono);
    color: var(--green);
    font-size: 1rem;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cursor {
    display: inline-block;
    width: 10px;
    height: 1.1em;
    background: var(--green);
    animation: blink 1s step-end infinite;
    vertical-align: text-bottom;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin-bottom: 24px;
    color: var(--white);
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--green), var(--cyan));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-desc {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    color: var(--muted);
    max-width: 540px;
    line-height: 1.7;
    margin-bottom: 10px;
  }

  .hero-desc strong { color: var(--white); font-weight: 600; }

  .hero-loc {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 28px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
  }

  .btn-wa {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 28px;
    background: var(--green-wa);
    color: #000;
    border: none;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 800;
    text-decoration: none;
    transition: all 0.2s var(--ease-out);
    animation: wa-glow 2.5s ease-in-out infinite;
  }

  .btn-wa:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 30px rgba(37, 211, 102, 0.35);
  }

  @keyframes wa-glow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
    50% { box-shadow: 0 0 24px 6px rgba(37, 211, 102, 0.18); }
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 16px 28px;
    background: transparent;
    color: var(--white);
    border: 1px solid var(--line);
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s var(--ease-out);
  }

  .btn-secondary:hover {
    border-color: var(--green);
    color: var(--green);
    box-shadow: 0 0 16px rgba(16,185,129, 0.1);
  }

  /* Code snippet — glass claro menta */
  .hero-code {
    background: rgba(255,255,255,0.68);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    border: 1px solid rgba(16,185,129,0.14);
    border-radius: 16px;
    overflow: hidden;
    font-family: var(--mono);
    font-size: 0.78rem;
    box-shadow: 0 8px 32px rgba(16,185,129,0.12), 0 2px 8px rgba(0,0,0,0.06);
    transform: perspective(1000px) rotateY(-3deg) rotateX(2deg);
    transition: transform 0.4s var(--ease-out);
  }

  .hero-code:hover {
    transform: perspective(1000px) rotateY(0deg) rotateX(0deg);
    background: rgba(255,255,255,0.78);
  }

  .hero-code-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background: rgba(255,255,255,0.45);
    border-bottom: 1px solid rgba(16,185,129,0.12);
  }

  .hero-code-title {
    margin-left: 8px;
    color: var(--muted);
    font-size: 0.72rem;
  }

  .hero-code-body {
    padding: 20px;
    line-height: 1.9;
    color: #344E41;
  }

  .code-keyword { color: #0E9F6E; font-weight: 600; }
  .code-string { color: #059669; }
  .code-prop { color: #022C22; font-weight: 600; }
  .code-comment { color: #8FA89B; font-style: italic; }

  .code-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .code-dot.red { background: #ff5f57; }
  .code-dot.yellow { background: #ffbd2e; }
  .code-dot.green { background: #28c840; }

  @media (max-width: 1024px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }

    .hero-content {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-desc {
      margin-inline: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-code {
      max-width: 520px;
      width: 100%;
      margin: 0 auto;
      transform: none;
    }

    .hero-code:hover {
      transform: none;
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 80px 0 64px;
    }

    h1 {
      font-size: clamp(2.2rem, 8vw, 2.8rem);
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      max-width: 320px;
    }

    .btn-wa,
    .btn-secondary {
      justify-content: center;
    }

    .hero-code {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor,
    .hero-code,
    .btn-wa {
      animation: none !important;
    }
  }
</style>
