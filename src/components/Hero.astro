---
import { projects } from "../data/projects";
import { BUILD_DATE, LOCATION, whatsappLink } from "../data/site";
import { pick, projectPath, useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const wa = whatsappLink(t("wa.message"));

// El panel muestra los sistemas reales del portafolio; cada fila abre su caso de estudio.
const rows = projects.slice(0, 5).map((project) => ({
  name: project.name,
  detail: project.domain ?? pick(project.client, lang),
  href: projectPath(project.slug, lang),
}));
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-badge rise" style="--d: 0">
        <span class="dot dot-pulse" aria-hidden="true"></span>
        <span>{t("hero.badge")}</span>
        <span class="hero-badge-sep" aria-hidden="true">·</span>
        <span class="hero-badge-cmd">{t("hero.prompt")}</span>
      </p>

      <h1 class="hero-title" id="hero-title">
        <span class="hero-line">{t("hero.title.line1")}</span>
        <span class="hero-line hero-line-accent">{t("hero.title.line2")}</span>
      </h1>

      <p class="hero-desc rise" style="--d: 120">{t("hero.desc")}</p>

      <div class="hero-actions rise" style="--d: 220">
        <a class="btn btn-primary btn-lg" href={wa} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-track-prop-place="hero">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5.1 5.24-1.37A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.1.82.83-3.03-.2-.31a8.22 8.22 0 1 1 6.95 3.85Zm4.5-6.15c-.25-.12-1.46-.72-1.69-.8-.23-.09-.39-.13-.56.12-.16.25-.64.8-.78.97-.15.16-.29.18-.54.06a6.7 6.7 0 0 1-1.98-1.22 7.4 7.4 0 0 1-1.37-1.7c-.14-.25 0-.38.11-.5.11-.12.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.42h-.47a.9.9 0 0 0-.65.3 2.74 2.74 0 0 0-.86 2.04c0 1.2.88 2.37 1 2.53.12.17 1.73 2.64 4.2 3.7.58.26 1.04.41 1.4.52.59.19 1.12.16 1.55.1.47-.07 1.46-.6 1.66-1.18.21-.58.21-1.07.15-1.18-.06-.1-.22-.16-.47-.29Z"></path></svg>
          {t("hero.cta.whatsapp")}
        </a>
        <a class="btn btn-ghost btn-lg" href="#proyectos">
          {t("hero.cta.projects")}
          <span class="hero-arrow" aria-hidden="true">↓</span>
        </a>
      </div>

      <p class="hero-loc rise" style="--d: 300">{t("hero.loc")}</p>
      <p class="hero-hint rise" style="--d: 360">
        <span>{t("hero.hint.before")}</span>
        <button class="hero-kbd" type="button" data-cmdk-open aria-label={t("palette.open")}><kbd data-kbd-mod>Ctrl K</kbd></button>
        <span>{t("hero.hint.after")}</span>
      </p>
    </div>

    <div class="hero-panel rise" style="--d: 260" role="group" aria-label={t("hero.panel.label")}>
      <div class="panel-bar">
        <span class="panel-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="panel-path">nikko@edge: ~/prod</span>
        <span class="panel-live"><span class="dot dot-pulse" aria-hidden="true"></span>live</span>
      </div>

      <div class="panel-body">
        <p class="panel-cmd"><span class="panel-prompt" aria-hidden="true">$</span> nikko status --prod</p>
        <p class="panel-caption">{t("hero.panel.caption")} · {projects.length}</p>
        <ul class="panel-rows" role="list">
          {rows.map((row, index) => (
            <li style={`--i: ${index}`}>
              <a class="panel-row" href={row.href}>
                <span class="panel-row-dot" aria-hidden="true"></span>
                <span class="panel-row-name">{row.name}</span>
                <span class="panel-row-detail">{row.detail}</span>
                <span class="panel-row-state" aria-hidden="true">PROD</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <dl class="panel-foot">
        <div>
          <dt>{t("hero.panel.time")}</dt>
          <dd><time data-clock data-tz={LOCATION.timeZone}>--:--</time> <span class="panel-dim">{LOCATION.utcLabel}</span></dd>
        </div>
        <div>
          <dt>{t("hero.panel.build")}</dt>
          <dd><time datetime={BUILD_DATE}>{BUILD_DATE}</time></dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(32px, 5vw, 72px) clamp(48px, 6vw, 80px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: center;
    gap: clamp(36px, 5vw, 72px);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 28px;
    padding: 7px 14px 7px 12px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-accent);
    background: var(--accent-soft);
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .hero-badge-sep {
    opacity: 0.5;
  }

  .hero-badge-cmd {
    color: var(--text-2);
  }

  .hero-title {
    font-size: clamp(2.25rem, 1.2rem + 2.8vw, 3.35rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.048em;
  }

  .hero-line {
    display: block;
  }

  .hero-line-accent {
    margin-top: 0.12em;
    padding-bottom: 0.08em;
    background: linear-gradient(95deg, var(--accent-text) 10%, var(--aqua-text) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-desc {
    max-width: 590px;
    margin-top: 26px;
    color: var(--text-2);
    font-size: clamp(1.02rem, 0.98rem + 0.25vw, 1.14rem);
    line-height: 1.72;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .hero-arrow {
    transition: translate 0.2s var(--ease);
  }

  .hero-actions .btn-ghost:hover .hero-arrow {
    translate: 0 3px;
  }

  .hero-loc {
    margin-top: 28px;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .hero-hint {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    color: var(--text-3);
    font-size: 0.86rem;
  }

  .hero-kbd {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: 6px;
  }

  .hero-kbd:hover :global(kbd) {
    color: var(--accent-text);
    border-color: var(--border-accent);
  }

  /* ── Panel "consola" con scanlines CRT sutiles ── */
  .hero-panel {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-2);
    background: var(--glass);
    box-shadow:
      var(--shadow-2),
      0 0 90px -30px rgba(var(--accent-rgb), 0.35);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    backdrop-filter: blur(20px) saturate(160%);
  }

  .hero-panel::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(to bottom, var(--scanline) 0 1px, transparent 1px 3px);
  }

  .panel-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 44px;
    padding: 0 16px;
    border-bottom: 1px solid var(--border);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .panel-dots {
    display: flex;
    gap: 6px;
  }

  .panel-dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px solid var(--border-2);
    background: var(--surface-2);
  }

  .panel-dots i:first-child {
    border-color: transparent;
    background: var(--accent);
  }

  .panel-path {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .panel-live {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--accent-text);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .panel-body {
    padding: 18px 14px 8px;
  }

  .panel-cmd {
    padding-inline: 6px;
    margin-bottom: 14px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .panel-prompt {
    margin-right: 4px;
    color: var(--accent-text);
  }

  .panel-caption {
    padding: 0 6px 8px;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .panel-rows {
    display: grid;
    gap: 2px;
  }

  .panel-row {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 10px;
    border-radius: 10px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    transition: background-color 0.2s var(--ease);
  }

  .panel-row:hover {
    background: var(--surface-2);
  }

  .panel-row-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px rgba(var(--accent-rgb), 0.7);
  }

  .panel-row-name {
    color: var(--text);
    font-weight: 600;
  }

  .panel-row-detail {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-3);
  }

  .panel-row-state {
    padding: 3px 8px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(var(--accent-rgb), 0.28);
    background: var(--accent-soft);
    color: var(--accent-text);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
  }

  .panel-foot {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 8px;
    border-top: 1px solid var(--border);
  }

  .panel-foot > div {
    padding: 14px 20px 16px;
  }

  .panel-foot > div + div {
    border-left: 1px solid var(--border);
  }

  .panel-foot dt {
    margin-bottom: 4px;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .panel-foot dd {
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .panel-dim {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .panel-rows li {
      animation: rise 0.7s var(--ease) both;
      animation-delay: calc(420ms + var(--i) * 90ms);
    }
  }

  @media (max-width: 1023px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-panel {
      max-width: 620px;
    }
  }

  @media (max-width: 480px) {
    .hero-actions .btn {
      width: 100%;
    }

    .panel-row {
      grid-template-columns: auto auto minmax(0, 1fr);
    }

    .panel-row-state {
      display: none;
    }
  }
</style>
