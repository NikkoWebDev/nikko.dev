---
import { getTranslation, type Lang } from "../data/translations";

export interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
---
<nav class="navbar" role="navigation" aria-label="Navegación principal">
  <div class="nav-inner">
    <a href="#" class="brand" aria-label="NikkoDev inicio">
      <div class="brand-mark">N</div>
      <span class="brand-name">Nikko<span class="green">Dev</span></span>
    </a>

    <div class="nav-links">
      <a href="#servicios">{getTranslation("nav.servicios", lang)}</a>
      <a href="#proyectos">{getTranslation("nav.proyectos", lang)}</a>
      <a href="#sobre-mi">{getTranslation("nav.sobre-mi", lang)}</a>
      <a href="#experiencia">{getTranslation("nav.experiencia", lang)}</a>
      <a href="#contacto">{getTranslation("nav.contacto", lang)}</a>
    </div>

    <div class="nav-actions">
      <button class="theme-btn" type="button" id="themeToggle" aria-label="Cambiar tema">
        <span class="theme-icon-dark" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </span>
        <span class="theme-icon-light" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        </span>
      </button>
      <button class="lang-btn" type="button" id="langToggle" aria-label="Cambiar idioma">
        <span class={`lang-text ${lang === "en" ? "inactive" : ""}`}>ES</span>
        <span class="lang-divider">/</span>
        <span class={`lang-text ${lang === "es" ? "inactive" : ""}`}>EN</span>
      </button>
      <a class="btn btn-primary btn-sm" href="https://wa.me/573136638097" target="_blank" rel="noopener">
        {getTranslation("nav.hablemos", lang)}
      </a>
    </div>

    <button class="mobile-toggle" id="mobileToggle" aria-label="Menú" type="button" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 16px;
    z-index: 1000;
    margin-top: 16px;
  }

  .nav-inner {
    width: min(var(--max), calc(100% - 40px));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border: 1px solid rgba(16,185,129,0.14);
    background: rgba(255,255,255,0.78);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border-radius: var(--radius-full);
    padding: 10px 14px;
    box-shadow: 0 8px 32px rgba(16,185,129,0.10), 0 2px 8px rgba(0,0,0,0.04);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: -0.03em;
  }

  .brand-mark {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #10B981, #34D399);
    color: #022C22;
    font-family: var(--mono);
    font-weight: 900;
    font-size: 1rem;
    box-shadow: 0 4px 16px rgba(16,185,129,0.28);
  }

  .brand-name { color: var(--white); }
  .brand-name .green { color: var(--green); }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .nav-links a {
    position: relative;
    padding: 4px 0;
  }

  .nav-links a::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1.5px;
    background: var(--green);
    transition: width 0.3s var(--ease);
  }

  .nav-links a:hover {
    color: var(--white);
  }

  .nav-links a:hover::after {
    width: 100%;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .lang-btn {
    display: flex;
    align-items: center;
    gap: 4px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.04);
    color: var(--white);
    padding: 8px 12px;
    border-radius: var(--radius-full);
    font-family: var(--mono);
    font-size: 0.78rem;
    cursor: pointer;
    transition: border-color 0.2s var(--ease);
  }

  .lang-btn:hover { border-color: var(--green); }

  .lang-text { transition: opacity 0.2s var(--ease); }
  .lang-text.inactive { opacity: 0.35; }
  .lang-divider { opacity: 0.2; }

  .theme-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--line);
    background: var(--glass-card);
    color: var(--white);
    border-radius: 50%;
    cursor: pointer;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
    font-size: 1rem;
    line-height: 1;
  }

  .theme-btn:hover {
    border-color: var(--green);
    background: var(--glass-card-hover);
  }

  .theme-icon-dark, .theme-icon-light {
    position: absolute;
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
  }

  .theme-icon-light { opacity: 0; transform: rotate(-90deg) scale(0); }
  :global(.light) .theme-icon-light { opacity: 1; transform: rotate(0) scale(1); }
  :global(.light) .theme-icon-dark { opacity: 0; transform: rotate(90deg) scale(0); }

  .theme-btn { position: relative; }

  .btn-sm {
    padding: 10px 18px;
    font-size: 0.85rem;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }

  .mobile-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--white);
    border-radius: 2px;
    transition: 0.3s var(--ease);
  }

  /* Mobile menu overlay */
  .mobile-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: var(--glass-bg-heavy);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    z-index: 999;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 32px;
    opacity: 0;
    transition: opacity 0.4s cubic-bezier(0.22, 0.7, 0.2, 1);
  }

  .mobile-overlay.open {
    display: flex;
    opacity: 1;
  }

  .mobile-overlay a {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--white);
    letter-spacing: -0.03em;
  }

  .mobile-overlay a:hover {
    color: var(--green);
  }

  .mobile-overlay .btn {
    margin-top: 12px;
    font-size: 1.1rem;
    padding: 16px 32px;
  }

  @media (max-width: 768px) {
    .nav-links, .nav-actions .btn-primary {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }

    .nav-inner {
      padding: 8px 12px;
      gap: 10px;
    }

    .brand-name {
      display: none;
    }

    .nav-actions {
      gap: 8px;
      margin-left: auto;
    }

    .theme-btn {
      width: 36px;
      height: 36px;
    }

    .lang-btn {
      padding: 7px 10px;
      font-size: 0.72rem;
    }
  }
</style>

<div class="mobile-overlay" id="mobileOverlay">
  <a href="#servicios" data-mobile-close>{getTranslation("nav.servicios", lang)}</a>
  <a href="#proyectos" data-mobile-close>{getTranslation("nav.proyectos", lang)}</a>
  <a href="#sobre-mi" data-mobile-close>{getTranslation("nav.sobre-mi", lang)}</a>
  <a href="#experiencia" data-mobile-close>{getTranslation("nav.experiencia", lang)}</a>
  <a href="#contacto" data-mobile-close>{getTranslation("nav.contacto", lang)}</a>
  <a class="btn btn-primary" href="https://wa.me/573136638097" target="_blank" rel="noopener noreferrer" data-mobile-close>
    {getTranslation("nav.hablemos", lang)}
  </a>
</div>

<script>
  // Language toggle — navigate between ES/EN versions
  document.getElementById('langToggle')?.addEventListener('click', () => {
    const currentLang = window.location.pathname.startsWith('/en') ? 'en' : 'es';
    const texts = document.querySelectorAll('.lang-text');
    const [es, en] = texts;
    if (currentLang === 'es') {
      es.classList.add('inactive');
      en.classList.remove('inactive');
    } else {
      en.classList.add('inactive');
      es.classList.remove('inactive');
    }
    setTimeout(() => {
      window.location.href = currentLang === 'es' ? '/en' : '/';
    }, 150);
  });

  // Mobile menu
  (() => {
    const toggle = document.getElementById('mobileToggle');
    const overlay = document.getElementById('mobileOverlay');
    if (!toggle || !overlay) return;

    const open = () => {
      overlay.classList.add('open');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      overlay.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };

    toggle.addEventListener('click', () => {
      if (overlay.classList.contains('open')) close();
      else open();
    });

    overlay.querySelectorAll('[data-mobile-close]').forEach(el => {
      el.addEventListener('click', close);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay.classList.contains('open')) close();
    });
  })();

  // Theme toggle
  document.getElementById('themeToggle')?.addEventListener('click', () => {
    const html = document.documentElement;
    const isLight = html.classList.toggle('light');
    localStorage.setItem('nikkodev-theme', isLight ? 'light' : 'dark');
  });
</script>
