---
import { SECTIONS, whatsappLink } from "../data/site";
import { alternatePath, homePath, normalizePath, otherLang, sectionPath, useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
const onHome = normalizePath(path) === homePath(lang);
const sectionHref = (id: string) => (onHome ? `#${id}` : sectionPath(id, lang));
const other = otherLang(lang);
const altHref = alternatePath(path, other);
const wa = whatsappLink(t("wa.message"));
const navSections = SECTIONS.filter((section) => section.inNav);
---

<header class="nav" id="top" data-nav>
  <div class="nav-bar">
    <a class="nav-brand" href={homePath(lang)} aria-label={t("nav.home")}>
      <img class="nav-logo" src="/logo-nav.png" alt="" width="32" height="32" />
      <span class="nav-wordmark" aria-hidden="true">Nikko<span>Dev</span></span>
    </a>

    <nav class="nav-links" aria-label={t("nav.label")}>
      <ul role="list">
        {navSections.map((section) => (
          <li><a href={sectionHref(section.id)} data-nav-link={section.id}>{t(section.navKey)}</a></li>
        ))}
      </ul>
    </nav>

    <div class="nav-actions">
      <button class="nav-btn nav-search" type="button" data-cmdk-open aria-label={t("palette.open")} aria-keyshortcuts="Control+K Meta+K">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <kbd class="nav-kbd" data-kbd-mod>Ctrl K</kbd>
      </button>
      <a class="nav-btn nav-lang" href={altHref} hreflang={other} aria-label={t("lang.switch")} data-lang-switch data-track="lang_toggle" data-track-prop-target={other}>
        <span class={lang === "es" ? "is-current" : undefined}>ES</span>
        <span class="nav-lang-sep" aria-hidden="true">/</span>
        <span class={lang === "en" ? "is-current" : undefined}>EN</span>
      </a>
      <button class="nav-btn nav-theme" type="button" data-theme-toggle aria-label={t("theme.toLight")} title={t("theme.toLight")} data-label-to-light={t("theme.toLight")} data-label-to-dark={t("theme.toDark")}>
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      </button>
      <a class="btn btn-primary btn-sm nav-cta" href={wa} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-track-prop-place="nav">{t("nav.hablemos")}</a>
      <button class="nav-btn nav-menu" type="button" data-menu-open aria-haspopup="dialog" aria-expanded="false" aria-controls="mobileMenu" aria-label={t("nav.menu.open")}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"></path></svg>
      </button>
    </div>
  </div>
</header>

<dialog class="menu" id="mobileMenu" aria-label={t("nav.menu.title")}>
  <div class="menu-panel">
    <div class="menu-head">
      <span class="menu-title">{t("nav.menu.title")}</span>
      <button class="nav-btn" type="button" data-menu-close aria-label={t("nav.menu.close")}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
    </div>
    <nav aria-label={t("nav.label")}>
      <ul class="menu-links" role="list">
        {SECTIONS.map((section, index) => (
          <li><a href={sectionHref(section.id)} data-menu-close data-nav-link={section.id}><span class="menu-index">{String(index + 1).padStart(2, "0")}</span>{t(section.navKey)}</a></li>
        ))}
      </ul>
    </nav>
    <div class="menu-foot">
      <a class="btn btn-ghost" href={altHref} hreflang={other} aria-label={t("lang.switch")} data-lang-switch data-track="lang_toggle" data-track-prop-target={other}>{lang === "es" ? "English" : "Español"}</a>
      <button class="btn btn-ghost" type="button" data-theme-toggle aria-label={t("theme.toLight")} data-label-to-light={t("theme.toLight")} data-label-to-dark={t("theme.toDark")}>{t("theme.label")}</button>
      <a class="btn btn-primary menu-wa" href={wa} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-track-prop-place="menu">{t("hero.cta.whatsapp")}</a>
    </div>
  </div>
</dialog>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 1000;
    padding-top: 12px;
  }

  .nav-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    width: min(var(--container), 100% - 2 * var(--gutter));
    height: var(--nav-h);
    margin-inline: auto;
    padding: 0 10px 0 14px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 58%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    backdrop-filter: blur(18px) saturate(160%);
    box-shadow: var(--shadow-1);
    transition:
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .nav.is-scrolled .nav-bar {
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    border-color: var(--border-2);
    box-shadow: var(--shadow-2);
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 1.06rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    border-radius: var(--radius-full);
  }

  .nav-logo {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--border-2);
  }

  .nav-wordmark span {
    color: var(--accent-text);
  }

  .nav-links {
    margin-inline: auto;
  }

  .nav-links ul {
    display: flex;
    gap: 2px;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 13px;
    border-radius: var(--radius-full);
    color: var(--text-2);
    font-size: 0.9rem;
    font-weight: 500;
    transition:
      color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .nav-links a:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  .nav-links a[aria-current="true"] {
    color: var(--accent-text);
    background: var(--accent-soft);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 40px;
    min-width: 40px;
    padding: 0 10px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-2);
    cursor: pointer;
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .nav-btn:hover {
    color: var(--text);
    border-color: var(--border-accent);
    background: var(--surface-2);
  }

  .nav-kbd {
    padding: 3px 5px;
    font-size: 0.68rem;
  }

  .nav-lang {
    gap: 4px;
    padding: 0 12px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-3);
  }

  .nav-lang .is-current {
    color: var(--text);
    font-weight: 600;
  }

  .nav-lang-sep {
    opacity: 0.45;
  }

  .icon-moon {
    display: none;
  }

  :global(.light) .icon-sun {
    display: none;
  }

  :global(.light) .icon-moon {
    display: block;
  }

  .nav-cta {
    margin-left: 4px;
  }

  .nav-menu {
    display: none;
  }

  @media (max-width: 1023px) {
    .nav-links,
    .nav-cta {
      display: none;
    }

    .nav-actions {
      margin-left: auto;
    }

    .nav-menu {
      display: inline-flex;
    }
  }

  @media (max-width: 520px) {
    .nav-lang,
    .nav-theme,
    .nav-kbd {
      display: none;
    }
  }

  @media (hover: none) {
    .nav-kbd {
      display: none;
    }
  }

  /* ── Menú móvil (<dialog> modal: foco atrapado y Escape gratis) ── */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
  }

  .menu::backdrop {
    background: rgba(2, 7, 6, 0.55);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .menu-panel {
    display: flex;
    flex-direction: column;
    gap: 22px;
    width: min(420px, 100% - 24px);
    max-height: calc(100% - 24px);
    margin: 12px 12px 0 auto;
    padding: 18px;
    overflow-y: auto;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-2);
    background: var(--glass-strong);
    box-shadow: var(--shadow-2);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    backdrop-filter: blur(24px) saturate(160%);
  }

  .menu[open] .menu-panel {
    animation: menu-in 0.32s var(--ease);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      translate: 0 -8px;
    }
  }

  .menu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .menu-title {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .menu-links {
    display: grid;
    gap: 2px;
  }

  .menu-links a {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 12px 10px;
    border-radius: var(--radius-m);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .menu-links a:hover,
  .menu-links a[aria-current="true"] {
    background: var(--surface-2);
    color: var(--accent-text);
  }

  .menu-index {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 400;
    color: var(--text-3);
  }

  .menu-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }

  .menu-wa {
    flex: 1 1 100%;
  }
</style>
