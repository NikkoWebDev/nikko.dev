---
import { BUILD_DATE, CONTACT, SECTIONS, whatsappLink } from "../data/site";
import { homePath, normalizePath, sectionPath, useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
const onHome = normalizePath(path) === homePath(lang);
const sectionHref = (id: string) => (onHome ? `#${id}` : sectionPath(id, lang));
const wa = whatsappLink(t("wa.message"));
const year = new Date().getFullYear();

const elsewhere = [
  { label: "GitHub", href: CONTACT.github, track: "social_click" },
  { label: "LinkedIn", href: CONTACT.linkedin, track: "social_click" },
  { label: "WhatsApp", href: wa, track: "whatsapp_click" },
];
---

<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="footer-logo" href={homePath(lang)} aria-label={t("nav.home")}>
        <img src="/logo-nav.png" alt="" width="36" height="36" loading="lazy" />
        <span aria-hidden="true">Nikko<span>Dev</span></span>
      </a>
      <p class="footer-role">{t("footer.role")}</p>
      <p class="footer-made">{t("footer.made")}</p>
    </div>

    <nav class="footer-col" aria-label={t("footer.nav")}>
      <p class="footer-title">{t("footer.nav")}</p>
      <ul role="list">
        {SECTIONS.map((section) => (
          <li><a href={sectionHref(section.id)}>{t(section.navKey)}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-col">
      <p class="footer-title">{t("footer.elsewhere")}</p>
      <ul role="list">
        {elsewhere.map((item) => (
          <li><a href={item.href} target="_blank" rel="noopener noreferrer" data-track={item.track} data-track-prop-place="footer">{item.label} <span aria-hidden="true">↗</span></a></li>
        ))}
        <li><a href={`mailto:${CONTACT.email}`} data-track="email_click">{CONTACT.email}</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bar">
    <p>© {year} NikkoDev</p>
    <p class="footer-status">
      <span>{lang.toUpperCase()}</span>
      <span aria-hidden="true">·</span>
      <span>build <time datetime={BUILD_DATE}>{BUILD_DATE}</time></span>
      <span class="footer-kbd" aria-hidden="true">· {t("footer.palette")} <kbd data-kbd-mod>Ctrl K</kbd></span>
    </p>
    <a class="footer-top" href="#top">{t("footer.top")} <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<a class="wa-float" href={wa} target="_blank" rel="noopener noreferrer" aria-label={t("wa.float")} data-wa-float data-track="whatsapp_click" data-track-prop-place="float">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5.1 5.24-1.37A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.1.82.83-3.03-.2-.31a8.22 8.22 0 1 1 6.95 3.85Zm4.5-6.15c-.25-.12-1.46-.72-1.69-.8-.23-.09-.39-.13-.56.12-.16.25-.64.8-.78.97-.15.16-.29.18-.54.06a6.7 6.7 0 0 1-1.98-1.22 7.4 7.4 0 0 1-1.37-1.7c-.14-.25 0-.38.11-.5.11-.12.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.42h-.47a.9.9 0 0 0-.65.3 2.74 2.74 0 0 0-.86 2.04c0 1.2.88 2.37 1 2.53.12.17 1.73 2.64 4.2 3.7.58.26 1.04.41 1.4.52.59.19 1.12.16 1.55.1.47-.07 1.46-.6 1.66-1.18.21-.58.21-1.07.15-1.18-.06-.1-.22-.16-.47-.29Z"></path></svg>
</a>

<style>
  .footer {
    margin-top: clamp(40px, 6vw, 80px);
    border-top: 1px solid var(--border);
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--bg-2) 80%, transparent));
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 0.8fr));
    gap: 40px;
    padding-block: clamp(48px, 7vw, 72px) 40px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .footer-logo img {
    width: 36px;
    height: 36px;
    border-radius: 50%;
  }

  .footer-logo span span {
    color: var(--accent-text);
  }

  .footer-role {
    margin-top: 14px;
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .footer-made {
    max-width: 340px;
    margin-top: 8px;
    color: var(--text-3);
    font-size: 0.88rem;
  }

  .footer-title {
    margin-bottom: 14px;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-col ul {
    display: grid;
    gap: 8px;
  }

  .footer-col a {
    color: var(--text-2);
    font-size: 0.92rem;
    overflow-wrap: anywhere;
    transition: color 0.2s var(--ease);
  }

  .footer-col a:hover {
    color: var(--accent-text);
  }

  .footer-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 20px 28px;
    border-top: 1px solid var(--border);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .footer-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .footer-kbd {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .footer-top {
    color: var(--text-2);
    transition: color 0.2s var(--ease);
  }

  .footer-top:hover {
    color: var(--accent-text);
  }

  .wa-float {
    position: fixed;
    right: max(18px, env(safe-area-inset-right));
    bottom: max(18px, env(safe-area-inset-bottom));
    z-index: 900;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      0 14px 34px -10px rgba(var(--accent-rgb), 0.7);
    transition:
      opacity 0.3s var(--ease),
      translate 0.3s var(--ease),
      scale 0.2s var(--ease),
      visibility 0.3s;
  }

  .wa-float:hover {
    scale: 1.06;
  }

  /* Oculto (y fuera del orden de tabulación) hasta pasar el hero; sin JS se ve siempre. */
  :global(html.js) .wa-float:not(.is-visible) {
    visibility: hidden;
    opacity: 0;
    translate: 0 16px;
    pointer-events: none;
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (hover: none) {
    .footer-kbd {
      display: none;
    }
  }
</style>
