---
// Caso de estudio. proyectos/[slug].astro y en/projects/[slug].astro solo eligen el idioma.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../Footer.astro";
import Navbar from "../Navbar.astro";
import { projects, type Project } from "../../data/projects";
import { whatsappLink } from "../../data/site";
import { homePath, pick, projectPath, sectionPath, useTranslations, type Lang } from "../../i18n/utils";
import { absoluteUrl, breadcrumbSchema, caseStudySchema } from "../../lib/schema";

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const path = projectPath(project.slug, lang);
const title = pick(project.title, lang);
const pad = (value: number) => String(value).padStart(2, "0");
const index = projects.findIndex((item) => item.slug === project.slug);
const prev = projects[(index - 1 + projects.length) % projects.length];
const next = projects[(index + 1) % projects.length];
const wa = whatsappLink(t("wa.message"));

const steps = [
  { id: "problema", label: t("case.problem.label"), title: t("case.problem.title"), html: pick(project.problem, lang) },
  { id: "implementacion", label: t("case.work.label"), title: t("case.work.title"), html: pick(project.work, lang) },
  ...(project.why ? [{ id: "decisiones", label: t("case.why.label"), title: t("case.why.title"), html: pick(project.why, lang) }] : []),
  { id: "resultado", label: t("case.result.label"), title: t("case.result.title"), html: pick(project.result, lang) },
  { id: "retrospectiva", label: t("case.learn.label"), title: pick(project.learn.title, lang), html: pick(project.learn.text, lang) },
];

const schema = [
  caseStudySchema(project, lang),
  breadcrumbSchema([
    { name: t("meta.breadcrumb.home"), url: absoluteUrl(homePath(lang)) },
    { name: t("meta.breadcrumb.projects"), url: absoluteUrl(sectionPath("proyectos", lang)) },
    { name: title, url: absoluteUrl(path) },
  ]),
];
---

<BaseLayout title={`${title} — ${t("case.titleSuffix")}`} description={pick(project.summary, lang)} lang={lang} path={path} ogImage={project.image} ogType="article" schema={schema}>
  <Navbar lang={lang} path={path} />
  <main id="main" class="case" data-project-slug={project.slug}>
    <div class="container">
      <a class="case-back" href={sectionPath("proyectos", lang)}><span aria-hidden="true">←</span> {t("case.back")}</a>

      <header class="case-head">
        <p class="case-kicker rise" style="--d: 0">{t("case.kicker")} <span class="case-count">{pad(index + 1)} / {pad(projects.length)}</span></p>
        <h1 class="case-title">{title}</h1>
        <p class="case-tagline rise" style="--d: 100">{pick(project.tagline, lang)}</p>

        <dl class="case-facts rise" style="--d: 180">
          <div class="case-fact">
            <dt>{t("case.facts.type")}</dt>
            <dd>{pick(project.kind, lang)}</dd>
          </div>
          <div class="case-fact">
            <dt>{t("case.facts.status")}</dt>
            <dd><span class="dot dot-pulse" aria-hidden="true"></span> {t("projects.status")}</dd>
          </div>
          <div class="case-fact case-fact-lead">
            <dt>{t("case.facts.result")}</dt>
            <dd><strong>{project.highlight.value}</strong> <span>{pick(project.highlight.label, lang)}</span></dd>
          </div>
        </dl>

        <div class="case-actions rise" style="--d: 240">
          {project.links.demo && (
            <a class="btn btn-primary" href={project.links.demo} target="_blank" rel="noopener noreferrer" data-track="demo_click" data-track-prop-project={project.slug}>{t("case.demo")} <span aria-hidden="true">↗</span></a>
          )}
          {project.links.repo && (
            <a class="btn btn-ghost" href={project.links.repo} target="_blank" rel="noopener noreferrer" data-track="code_click" data-track-prop-project={project.slug}>{t("case.repo")} <span aria-hidden="true">↗</span></a>
          )}
          <a class={project.links.demo ? "btn btn-ghost" : "btn btn-primary"} href={wa} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-track-prop-place="case">{t("case.cta.whatsapp")}</a>
        </div>
      </header>

      <figure class="case-shot rise" style="--d: 300">
        <div class="case-chrome" aria-hidden="true">
          <span class="case-dots"><i></i><i></i><i></i></span>
          <span class="case-url">{project.domain ?? project.name}</span>
        </div>
        <img src={project.image} srcset={`${project.imageSmall} 640w, ${project.image} 1280w`} sizes="(min-width: 1240px) 1200px, 100vw" width="1280" height="800" alt={`${t("case.shot")} ${project.name}`} fetchpriority="high" decoding="async" />
      </figure>

      <div class="case-layout">
        <aside class="case-aside">
          <div class="case-aside-block">
            <h2 class="case-aside-title">{t("case.stack")}</h2>
            <ul class="case-stack" role="list">
              {project.stack.map((item) => <li class="tag">{item}</li>)}
            </ul>
          </div>
          <nav class="case-aside-block" aria-label={t("case.toc")}>
            <h2 class="case-aside-title">{t("case.toc")}</h2>
            <ol class="case-toc" role="list">
              {steps.map((step, stepIndex) => (
                <li><a href={`#${step.id}`}><span>{pad(stepIndex + 1)}</span> {step.title}</a></li>
              ))}
            </ol>
          </nav>
        </aside>

        <div class="case-content">
          {steps.map((step, stepIndex) => (
            <section class="case-step" id={step.id} aria-labelledby={`${step.id}-title`} data-reveal>
              <p class="case-step-label"><span>{pad(stepIndex + 1)}</span> {step.label}</p>
              <h2 class="case-step-title" id={`${step.id}-title`}>{step.title}</h2>
              <p class="case-step-body" set:html={step.html}></p>
            </section>
          ))}
        </div>
      </div>

      <section class="case-cta" aria-labelledby="case-cta-title" data-spotlight data-reveal>
        <h2 class="case-cta-title" id="case-cta-title">{t("case.cta.title")}</h2>
        <p class="case-cta-text">{t("case.cta.text")}</p>
        <a class="btn btn-primary btn-lg" href={wa} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-track-prop-place="case-cta">{t("case.cta.whatsapp")}</a>
      </section>

      <nav class="case-pager" aria-label={t("case.more")}>
        <a class="case-pager-link" href={projectPath(prev.slug, lang)} rel="prev">
          <span class="case-pager-dir"><span aria-hidden="true">←</span> {t("case.prev")}</span>
          <span class="case-pager-name">{prev.name}</span>
        </a>
        <a class="case-pager-link case-pager-next" href={projectPath(next.slug, lang)} rel="next">
          <span class="case-pager-dir">{t("case.next")} <span aria-hidden="true">→</span></span>
          <span class="case-pager-name">{next.name}</span>
        </a>
      </nav>
    </div>
  </main>
  <Footer lang={lang} path={path} />
</BaseLayout>

<style>
  .case {
    padding-block: clamp(28px, 5vw, 56px) 0;
  }

  .case-back {
    display: inline-flex;
    gap: 8px;
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    transition: color 0.2s var(--ease);
  }

  .case-back:hover {
    color: var(--accent-text);
  }

  .case-head {
    max-width: 880px;
    margin-top: clamp(28px, 4vw, 44px);
  }

  .case-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .case-count {
    color: var(--text-3);
  }

  .case-title {
    margin-top: 16px;
    font-size: clamp(2.1rem, 1.3rem + 3vw, 3.6rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .case-tagline {
    max-width: 720px;
    margin-top: 20px;
    color: var(--text-2);
    font-size: clamp(1.04rem, 0.98rem + 0.3vw, 1.2rem);
    line-height: 1.65;
  }

  .case-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 30px;
  }

  .case-fact {
    padding: 14px 16px;
    border-radius: var(--radius-m);
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .case-fact dt {
    margin-bottom: 6px;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .case-fact dd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 8px;
    color: var(--text);
    font-size: 0.94rem;
    font-weight: 500;
  }

  .case-fact dd .dot {
    align-self: center;
  }

  .case-fact-lead {
    border-color: rgba(var(--accent-rgb), 0.28);
    background: var(--accent-soft);
  }

  .case-fact-lead strong {
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: 1.02rem;
  }

  .case-fact-lead span {
    color: var(--text-2);
    font-size: 0.84rem;
    font-weight: 400;
  }

  .case-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .case-shot {
    margin: clamp(36px, 5vw, 56px) 0 0;
    overflow: hidden;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-2);
    background: var(--bg-2);
    box-shadow:
      var(--shadow-2),
      0 0 120px -40px rgba(var(--accent-rgb), 0.35);
  }

  .case-chrome {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 40px;
    padding: 0 16px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .case-dots {
    display: flex;
    gap: 6px;
  }

  .case-dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border-2);
  }

  .case-dots i:first-child {
    background: var(--accent);
  }

  .case-url {
    flex: 1;
    max-width: 420px;
    margin-inline: auto;
    padding: 4px 12px;
    overflow: hidden;
    border-radius: 8px;
    background: var(--surface);
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .case-shot img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
  }

  .case-layout {
    display: grid;
    grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 88px);
    margin-top: clamp(48px, 7vw, 88px);
  }

  .case-aside {
    position: sticky;
    top: calc(var(--nav-h) + 40px);
    align-self: start;
    display: grid;
    gap: 28px;
  }

  .case-aside-title {
    margin-bottom: 12px;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .case-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .case-toc {
    display: grid;
    gap: 2px;
  }

  .case-toc a {
    display: flex;
    gap: 10px;
    padding: 7px 0;
    color: var(--text-2);
    font-size: 0.9rem;
    transition: color 0.2s var(--ease);
  }

  .case-toc a:hover {
    color: var(--accent-text);
  }

  .case-toc span {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    padding-top: 2px;
  }

  .case-content {
    display: grid;
    gap: clamp(36px, 5vw, 56px);
    max-width: 720px;
  }

  .case-step-label {
    display: flex;
    gap: 10px;
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .case-step-label span {
    color: var(--text-3);
  }

  .case-step-title {
    margin: 10px 0 14px;
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2.1rem);
    letter-spacing: -0.035em;
  }

  .case-step-body {
    color: var(--text-2);
    font-size: 1.06rem;
    line-height: 1.8;
  }

  .case-cta {
    display: grid;
    justify-items: start;
    gap: 14px;
    margin-top: clamp(64px, 9vw, 112px);
    padding: clamp(28px, 5vw, 52px);
    overflow: hidden;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-2);
    background:
      radial-gradient(560px 300px at 0% 0%, rgba(var(--accent-rgb), 0.16), transparent 65%),
      var(--glass);
    box-shadow: var(--shadow-2);
  }

  .case-cta-title {
    font-size: clamp(1.7rem, 1.3rem + 1.6vw, 2.6rem);
    letter-spacing: -0.04em;
  }

  .case-cta-text {
    max-width: 560px;
    margin-bottom: 8px;
    color: var(--text-2);
  }

  .case-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 16px;
  }

  .case-pager-link {
    display: grid;
    gap: 6px;
    padding: 20px 22px;
    border-radius: var(--radius-l);
    border: 1px solid var(--border);
    background: var(--surface);
    transition:
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .case-pager-link:hover {
    border-color: var(--border-accent);
    background: var(--surface-2);
  }

  .case-pager-next {
    text-align: right;
  }

  .case-pager-dir {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .case-pager-name {
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  @media (max-width: 900px) {
    .case-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .case-aside {
      position: static;
    }

    .case-toc {
      display: none;
    }

    .case-aside nav {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .case-facts {
      grid-template-columns: minmax(0, 1fr);
    }

    .case-pager {
      grid-template-columns: minmax(0, 1fr);
    }

    .case-pager-next {
      text-align: left;
    }
  }
</style>
