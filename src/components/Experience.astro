---
import { getTranslation, type Lang } from "../data/translations";
export interface Props { lang?: Lang; }
const { lang = "es" } = Astro.props;
---

<section id="experiencia" class="section-bg-alt">
  <div class="container">
    <div class="section-head" style="margin-bottom:28px;">
      <div class="eyebrow">{getTranslation("exp.eyebrow", lang)}</div>
      <h2 class="display-sm">{getTranslation("exp.title", lang)}</h2>
    </div>

    <div class="exp-timeline">
      <!-- Item 1: SinPresupuesto -->
      <div class="exp-node">
        <div class="exp-marker">
          <div class="exp-dot"></div>
          <div class="exp-connector"></div>
        </div>
        <div class="exp-card">
          <div class="exp-card-top">
            <span class="exp-date">{getTranslation("exp.item1.date", lang)}</span>
            <span class="exp-status">● Activo</span>
          </div>
          <h3>{getTranslation("exp.item1.title", lang)}</h3>
          <p>{getTranslation("exp.item1.desc", lang)}</p>
          <div class="exp-tags">
            <span class="tag">Next.js</span>
            <span class="tag">Cloudflare Workers</span>
            <span class="tag">Llama 3.1</span>
            <span class="tag">PWA</span>
            <span class="tag">OAuth</span>
          </div>
        </div>
      </div>

      <!-- Item 2: Freelance -->
      <div class="exp-node">
        <div class="exp-marker">
          <div class="exp-dot"></div>
          <div class="exp-connector"></div>
        </div>
        <div class="exp-card">
          <div class="exp-card-top">
            <span class="exp-date">{getTranslation("exp.item2.date", lang)}</span>
            <span class="exp-status" style="color:var(--cyan);">● En curso</span>
          </div>
          <h3>{getTranslation("exp.item2.title", lang)}</h3>
          <p>{getTranslation("exp.item2.desc", lang)}</p>
          <div class="exp-tags">
            <span class="tag">Astro</span>
            <span class="tag">Supabase</span>
            <span class="tag">PostgreSQL</span>
            <span class="tag">OpenRouter</span>
            <span class="tag">SEO</span>
          </div>
        </div>
      </div>

      <!-- Item 3: Logro clave -->
      <div class="exp-node">
        <div class="exp-marker">
          <div class="exp-dot exp-dot-accent"></div>
        </div>
        <div class="exp-card exp-card-accent">
          <div class="exp-card-top">
            <span class="exp-date">{getTranslation("exp.item3.date", lang)}</span>
            <span class="exp-status" style="color:var(--amber);">★ Destacado</span>
          </div>
          <h3>{getTranslation("exp.item3.title", lang)}</h3>
          <p>{getTranslation("exp.item3.desc", lang)}</p>
          <div class="exp-metric-line">
            <span>3s</span>
            <span class="exp-metric-bar">
              <span style="width:7%"></span>
            </span>
            <span>0.2s</span>
            <span class="exp-metric-bar green">
              <span style="width:93%"></span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .exp-timeline {
    display: grid;
    gap: 0;
    max-width: 820px;
    margin: 0 auto;
  }

  .exp-node {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px;
  }

  .exp-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 24px;
    padding-top: 6px;
  }

  .exp-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 20px rgba(0,208,132,0.4);
    flex-shrink: 0;
    position: relative;
    z-index: 2;
  }

  .exp-dot-accent {
    background: var(--amber);
    box-shadow: 0 0 20px rgba(212,168,83,0.3);
  }

  .exp-connector {
    width: 1.5px;
    flex: 1;
    background: linear-gradient(180deg, var(--green), var(--cyan), transparent);
    min-height: 20px;
    opacity: 0.4;
  }

  .exp-card {
    border: 1px solid var(--line);
    background: var(--glass-card);
    border-radius: 20px;
    padding: 26px;
    margin-bottom: 18px;
    transition: border-color 0.3s var(--ease);
  }

  .exp-card:hover { border-color: var(--line-green); }

  .exp-card-accent {
    border-color: var(--line-amber);
    background: rgba(212,168,83,0.03);
  }

  .exp-card-accent:hover { border-color: var(--amber); }

  .exp-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .exp-date {
    color: var(--green);
    font-family: var(--mono);
    font-size: 0.78rem;
  }

  .exp-status {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--green);
    opacity: 0.7;
  }

  .exp-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .exp-card p {
    color: var(--muted);
    line-height: 1.7;
    font-size: 0.9rem;
  }

  .exp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .exp-tags .tag {
    font-size: 0.7rem;
    padding: 6px 10px;
  }

  /* Metric comparison bar */
  .exp-metric-line {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--white);
  }

  .exp-metric-bar {
    flex: 1;
    height: 6px;
    background: var(--glass-card-strong);
    border-radius: 3px;
    overflow: hidden;
    position: relative;
  }

  .exp-metric-bar span {
    display: block;
    height: 100%;
    background: var(--muted);
    border-radius: 3px;
  }

  .exp-metric-bar.green span {
    background: linear-gradient(90deg, var(--green), var(--cyan));
  }

  @media (max-width: 640px) {
    .exp-node { gap: 12px; }
    .exp-card { padding: 18px; }
  }
</style>
