---
import { getTranslation, type Lang } from "../data/translations";

export interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;
---

<section id="sobre-mi">
  <div class="container">
    <div class="about-grid">
      <div class="about-text">
        <div class="eyebrow">{getTranslation("about.eyebrow", lang)}</div>
        <h2>{getTranslation("about.title", lang)}</h2>
        <p class="about-story">{getTranslation("about.story", lang)}</p>
        <div class="about-quote">
          "{getTranslation("about.quote", lang)}"
        </div>
      </div>

      <div class="about-card">
        <div class="card-header">
          <span class="card-title">Ingeniería & Perfil</span>
          <span class="badge-tag">UNAL Sistemas</span>
        </div>
        <div class="about-specs">
          <div class="spec-row">
            <span class="spec-label">Especialidad</span>
            <span class="spec-val">Edge Runtimes & Applied AI</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Enfoque</span>
            <span class="spec-val">RAG, Microservicios, Cloudflare Workers</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Stack Diario</span>
            <span class="spec-val">TypeScript, Python, Astro, Next.js, Supabase</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Ubicación</span>
            <span class="spec-val">Bogotá, Colombia (Remoto Global)</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Idiomas</span>
            <span class="spec-val">Español (Nativo) · Inglés (B2 Profesional)</span>
          </div>
        </div>
      </div>
    </div>

    <div class="currently">
      <div class="currently-header">{getTranslation("currently.title", lang)}</div>
      <div class="currently-body">
        <div class="log-line">
          <span class="log-time">[Prod]</span>
          <span class="log-level">CEIS</span>
          <span set:html={getTranslation("currently.log1", lang)}></span>
        </div>
        <div class="log-line">
          <span class="log-time">[Prod]</span>
          <span class="log-level">Reprebot</span>
          <span set:html={getTranslation("currently.log2", lang)}></span>
        </div>
        <div class="log-line">
          <span class="log-time">[Edge]</span>
          <span class="log-level">FIBOG</span>
          <span set:html={getTranslation("currently.log3", lang)}></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding: 96px 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .about-text .eyebrow {
    color: var(--accent-text);
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 14px;
    opacity: 0.8;
  }

  .about-text h2 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 24px;
  }

  .about-story {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.85;
    margin-bottom: 24px;
  }

  /* ── Quantum Glass About Card ── */
  .about-card {
    background: var(--glass-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-shadow);
    transition: all 0.3s var(--ease);
    position: relative;
  }

  .about-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
    pointer-events: none;
  }

  .about-card:hover {
    border-color: var(--line-green);
    box-shadow: var(--glass-shadow-hover);
    transform: translateY(-2px);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 22px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }

  .card-title {
    font-family: var(--mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--white);
  }

  .badge-tag {
    font-family: var(--mono);
    font-size: 0.72rem;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--accent-text);
  }

  .about-specs {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .spec-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }

  .spec-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .spec-label {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .spec-val {
    font-size: 0.92rem;
    color: var(--white);
    font-weight: 500;
  }

  /* Currently / system log */
  .currently {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    margin-top: 48px;
  }

  .currently-header {
    background: var(--bg-2);
    border-bottom: 1px solid var(--line);
    padding: 12px 16px;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .currently-header::before {
    content: "●";
    color: var(--accent-text);
    animation: pulse 2s infinite;
  }

  .currently-body {
    padding: 16px 20px;
    font-family: var(--mono);
    font-size: 0.82rem;
    line-height: 1.9;
  }

  .log-line {
    color: var(--muted);
    margin-bottom: 6px;
  }

  .log-time {
    color: rgba(139, 139, 150, 0.5);
    margin-right: 10px;
  }

  .log-level {
    color: var(--accent-text);
    margin-right: 10px;
  }

  .log-line span:last-child strong {
    color: var(--white);
    font-weight: 600;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @media (max-width: 1024px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }

    .about-text {
      max-width: 680px;
      margin: 0 auto;
    }

    .about-quote {
      text-align: left;
    }

    .about-editor {
      max-width: 620px;
      margin: 0 auto;
    }
  }

  @media (max-width: 640px) {
    .about-editor-body {
      grid-template-columns: 1fr;
    }

    .editor-sidebar {
      display: none;
    }

    .about-text h2 {
      font-size: 1.6rem;
    }

    .about-editor {
      font-size: 0.72rem;
    }

    .currently {
      margin-top: 36px;
    }

    .currently-body {
      font-size: 0.75rem;
      padding: 14px 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .currently-header::before {
      animation: none;
    }
  }
</style>
