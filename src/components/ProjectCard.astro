---
import type { Project } from "../data/projects";
import { pick, projectPath, useTranslations, type Lang } from "../i18n/utils";

interface Props {
  project: Project;
  index: number;
  lang: Lang;
  /** Tarjeta principal: ocupa 2×2 en escritorio. */
  feature?: boolean;
  /** Se muestra en horizontal cuando ocupa las dos columnas de tablet. */
  wide?: boolean;
}

const { project, index, lang, feature = false, wide = false } = Astro.props;
const t = useTranslations(lang);
const href = projectPath(project.slug, lang);
const number = String(index + 1).padStart(2, "0");
const tags = project.stack.slice(0, feature ? 6 : 4);
const sizes = feature ? "(min-width: 1100px) 760px, (min-width: 720px) 92vw, 100vw" : "(min-width: 1100px) 380px, (min-width: 720px) 46vw, 100vw";
const cardClass = ["work", feature ? "work-feature" : "", wide ? "work-wide" : ""].filter(Boolean).join(" ");
---

<article class={cardClass} data-spotlight>
  <div class="work-media">
    <div class="work-chrome" aria-hidden="true">
      <span class="work-chrome-dots"><i></i><i></i><i></i></span>
      <span class="work-chrome-url">{project.domain ?? project.name}</span>
      <span class="work-chrome-status"><span class="dot" aria-hidden="true"></span>prod</span>
    </div>
    <div class="work-shot">
      <img src={project.imageSmall} srcset={`${project.imageSmall} 640w, ${project.image} 1280w`} sizes={sizes} width="1280" height="800" alt={`${t("case.shot")} ${project.name}`} style={project.focus ? `object-position: ${project.focus}` : undefined} loading="lazy" decoding="async" />
    </div>
  </div>

  <div class="work-body">
    <p class="work-meta">
      <span class="work-index">{number}</span>
      <span class="work-kind">{pick(project.kind, lang)}</span>
      <span class="sr-only">· {t("projects.status")}</span>
    </p>
    <h3 class="work-title"><a class="work-link" href={href}>{project.name}</a></h3>
    <p class="work-tagline">{pick(project.tagline, lang)}</p>
    <p class="work-highlight"><strong>{project.highlight.value}</strong> <span>{pick(project.highlight.label, lang)}</span></p>
    {feature && (
      <div class="work-story">
        <div class="work-story-problem">
          <p class="work-story-label">{t("case.problem.label")}</p>
          <p set:html={pick(project.problem, lang)}></p>
        </div>
        <div>
          <p class="work-story-label">{t("case.result.label")}</p>
          <p set:html={pick(project.result, lang)}></p>
        </div>
      </div>
    )}
    <ul class="work-tags" role="list">
      {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
    <div class="work-actions">
      <span class="work-cta" aria-hidden="true">{t("projects.case")} <span class="work-cta-arrow">→</span></span>
      {project.links.demo && (
        <a class="work-ext" href={project.links.demo} target="_blank" rel="noopener noreferrer" aria-label={`${t("projects.btn.demo")}: ${project.name} (${t("a11y.newTab")})`} data-track="demo_click" data-track-prop-project={project.slug}>Demo ↗</a>
      )}
      {project.links.repo && (
        <a class="work-ext" href={project.links.repo} target="_blank" rel="noopener noreferrer" aria-label={`${t("projects.btn.code")}: ${project.name} (${t("a11y.newTab")})`} data-track="code_click" data-track-prop-project={project.slug}>{t("projects.btn.code")} ↗</a>
      )}
    </div>
  </div>
</article>

<style>
  .work {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-l);
    border: 1px solid var(--border);
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    box-shadow: var(--shadow-1);
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  .work:hover {
    transform: translateY(-3px);
    border-color: var(--border-accent);
    box-shadow: var(--shadow-2);
  }

  .work:has(.work-link:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .work-media {
    display: flex;
    flex-direction: column;
    margin: 10px 10px 0;
    overflow: hidden;
    border-radius: var(--radius-m);
    border: 1px solid var(--border);
    background: var(--bg-2);
  }

  .work-chrome {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 30px;
    padding: 0 12px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  .work-chrome-dots {
    display: flex;
    gap: 5px;
  }

  .work-chrome-dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--border-2);
  }

  .work-chrome-url {
    flex: 1;
    min-width: 0;
    padding: 2px 10px;
    overflow: hidden;
    border-radius: 6px;
    background: var(--surface);
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .work-chrome-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent-text);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .work-chrome-status .dot {
    width: 6px;
    height: 6px;
  }

  .work-shot {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .work-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.7s var(--ease);
  }

  .work:hover .work-shot img {
    transform: scale(1.035);
  }

  .work-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 14px;
    padding: 20px 22px 22px;
  }

  .work-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .work-index {
    color: var(--accent-text);
  }

  .work-kind {
    flex: 1;
    min-width: 0;
  }

  .work-story {
    display: grid;
    gap: 16px;
    padding-left: 14px;
    border-left: 2px solid rgba(var(--accent-rgb), 0.5);
  }

  .work-story-label {
    margin-bottom: 4px;
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .work-story p:not(.work-story-label) {
    color: var(--text-2);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .work-title {
    font-size: clamp(1.3rem, 1.15rem + 0.5vw, 1.6rem);
    letter-spacing: -0.035em;
  }

  .work-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .work-link:focus-visible {
    outline: none;
  }

  .work-tagline {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text-2);
    font-size: 0.94rem;
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .work-highlight {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid rgba(var(--accent-rgb), 0.18);
    background: var(--accent-soft);
  }

  .work-highlight strong {
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .work-highlight span {
    color: var(--text-2);
    font-size: 0.82rem;
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .work-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin-top: auto;
    padding-top: 4px;
  }

  .work-cta {
    margin-right: auto;
    color: var(--text);
    font-size: 0.88rem;
    font-weight: 600;
    transition: color 0.2s var(--ease);
  }

  .work-cta-arrow {
    display: inline-block;
    transition: translate 0.25s var(--ease);
  }

  .work:hover .work-cta {
    color: var(--accent-text);
  }

  .work:hover .work-cta-arrow {
    translate: 4px 0;
  }

  .work-ext {
    position: relative;
    z-index: 2;
    padding: 4px 0;
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    transition: color 0.2s var(--ease);
  }

  .work-ext:hover {
    color: var(--accent-text);
  }

  /* Principal: la captura crece para llenar las dos filas del bento. */
  .work-feature .work-media {
    flex: 1;
  }

  .work-feature .work-body {
    flex: 0 0 auto;
  }

  .work-feature .work-shot {
    flex: 1;
    min-height: 300px;
    aspect-ratio: auto;
  }

  .work-feature .work-title {
    font-size: clamp(1.6rem, 1.2rem + 1.1vw, 2.2rem);
  }

  .work-feature .work-tagline {
    font-size: 1rem;
    -webkit-line-clamp: 4;
    line-clamp: 4;
  }

  @media (max-width: 1099px) {
    .work-feature .work-shot {
      min-height: 0;
      aspect-ratio: 16 / 10;
    }
  }

  @media (min-width: 720px) and (max-width: 1099px) {
    .work-wide {
      flex-direction: row;
    }

    .work-wide .work-media {
      flex: 1.15;
      margin: 10px 0 10px 10px;
    }

    .work-wide .work-shot {
      flex: 1;
      aspect-ratio: auto;
      min-height: 260px;
    }

    .work-wide .work-body {
      flex: 1;
    }
  }

  /* En móvil la tarjeta principal conserva solo el resultado, para no alargar la página. */
  @media (max-width: 719px) {
    .work-story-problem {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work:hover,
    .work:hover .work-shot img {
      transform: none;
    }
  }
</style>
