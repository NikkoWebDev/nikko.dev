---
import ProjectCard from "./ProjectCard.astro";
import SectionHeading from "./SectionHeading.astro";
import { projects } from "../data/projects";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const lastIndex = projects.length - 1;
---

<section class="section" id="proyectos" aria-labelledby="proyectos-title">
  <div class="container">
    <SectionHeading id="proyectos-title" index="01" eyebrow={t("projects.eyebrow")} title={t("projects.title")} sub={t("projects.sub")} />
    <ul class="work-grid" role="list">
      {projects.map((project, index) => (
        <li class={index === 0 ? "work-item work-item-feature" : index === lastIndex ? "work-item work-item-last" : "work-item"} data-reveal>
          <ProjectCard project={project} index={index} lang={lang} feature={index === 0} wide={index === 0 || index === lastIndex} />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .work-item {
    min-width: 0;
  }

  .work-item-feature {
    grid-column: span 2;
    grid-row: span 2;
  }

  @media (max-width: 1099px) {
    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .work-item-feature,
    .work-item-last {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }

  @media (max-width: 719px) {
    .work-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
