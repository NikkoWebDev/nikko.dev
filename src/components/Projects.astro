---
import { getTranslation, type Lang } from "../data/translations";
import { projects as caseData } from "../data/projects";

export interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;

const projects = [
  {
    id: "reprebot",
    slug: "reprebot",
    tab: "Reprebot.py",
    image: "/projects/reprebot.jpg",
    demo: "https://repre.nikko.dev/",
    code: null,
    tags: ["Qwen 3.5 4B", "Fine-tune UNAL", "FastAPI", "RAG", "WhatsApp", "API"]
  },
  {
    id: "sinpre",
    slug: "sinpresupuesto",
    tab: "SinPresupuesto.ts",
    image: "/projects/sinpresupuesto.jpg",
    demo: "https://sinpresupuesto.com",
    code: "https://github.com/SinPresupuesto/SinPre",
    tags: ["Next.js", "Cloudflare Workers", "Supabase", "Llama 3.1", "OAuth", "PWA"]
  },
  {
    id: "fibog",
    slug: "fibog",
    tab: "FIBOG.tsx",
    image: "/projects/fibog.jpg",
    demo: "https://semilleros.nikko.dev",
    code: "https://github.com/NikkoWebDev/FIBOG",
    tags: ["Astro", "Supabase", "PostgreSQL", "RLS", "Accesibilidad", "UNAL"]
  },
  {
    id: "ceis",
    slug: "ceis",
    tab: "CEIS.tsx",
    image: "/projects/ceis.jpg",
    demo: "https://ceis-unal.com",
    code: null,
    tags: ["React", "Vite", "Supabase", "Tailwind CSS", "Malla Curricular", "UNAL"]
  },
  {
    id: "autorep",
    slug: "autorreparacion",
    tab: "Autorreparacion.astro",
    image: "/projects/autorreparacion.jpg",
    demo: "https://www.autorreparacion.com",
    code: null,
    tags: ["Astro", "GSAP", "SEO", "Responsive", "Cliente real"]
  },
  {
    id: "indusec",
    slug: "indusec",
    tab: "InduSEC.astro",
    image: "/projects/indusec.jpg",
    demo: "https://puertasindusec.com",
    code: "https://github.com/NikkoWebDev/induSEC-WEB",
    tags: ["Astro", "SEO", "Responsive", "Cliente real"]
  }
] as const;

const labels = {
  es: {
    problem: "El Desafío",
    do: "Qué hice",
    stack: "¿Por qué ese stack?",
    result: "Resultado",
    learnFibog: "Lo que aprendí",
    learnSinpre: "Lo que haría diferente",
    learnCeis: "Impacto institucional",
    learnRepre: "Lo que aprendí",
    learnAuto: "Lo que aprendería",
    learnIndu: "Lo que aprendería"
  },
  en: {
    problem: "The Challenge",
    do: "What I did",
    stack: "Why that stack?",
    result: "Result",
    learnFibog: "What I learned",
    learnSinpre: "What I'd do differently",
    learnCeis: "Institutional impact",
    learnRepre: "What I learned",
    learnAuto: "What I'd learn next",
    learnIndu: "What I'd learn next"
  }
};

function getBlockLabel(id: string, index: number, lang: Lang): string {
  const l = labels[lang];
  if (index === 0) return l.problem;
  if (index === 1) return l.do;
  if (index === 2) {
    if (id === "fibog") return l.stack;
    return l.result;
  }
  if (id === "fibog") return l.learnFibog;
  if (id === "sinpre") return l.learnSinpre;
  if (id === "ceis") return l.learnCeis;
  if (id === "reprebot") return l.learnRepre;
  if (id === "autorep") return l.learnAuto;
  return l.learnIndu;
}

const meta = Object.fromEntries(caseData.map((p) => [p.slug, p]));
const PALETTE_HEX = { mint: "#10B981", cyan: "#0EA5E9", violet: "#8B5CF6", amber: "#F59E0B", teal: "#14B8A6" } as const;

const ui = {
  es: { more: "Ver detalles", less: "Ocultar", caseStudy: "Caso de estudio completo", visible: 3 },
  en: { more: "View details", less: "Hide", caseStudy: "Full case study", visible: 3 },
}[lang];
---

<section id="proyectos">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">{getTranslation("projects.eyebrow", lang)}</div>
      <h2>{getTranslation("projects.title", lang)}</h2>
      <p class="section-sub">{getTranslation("projects.sub", lang)}</p>
    </div>

    <nav class="editor-tabs" aria-label={lang === "en" ? "Project index" : "Índice de proyectos"}>
      {projects.map((p) => (
        <a class="editor-tab" href={`#proyecto-${p.id}`} data-open-project={p.id}>
          <span class="editor-tab-icon" aria-hidden="true">◆</span>
          {p.tab}
        </a>
      ))}
    </nav>

    {projects.map((project, i) => {
      const info = meta[project.slug];
      const title = getTranslation(`projects.${project.id}.title` as any, lang);
      const caseHref = lang === "en" ? `/en/projects/${project.slug}/` : `/proyectos/${project.slug}/`;
      const keys: Record<string, string[]> = {
        fibog: ["problem", "do", "stack", "learn"],
        sinpre: ["problem", "do", "result", "learn"],
        ceis: ["problem", "do", "result", "learn"],
        reprebot: ["problem", "do", "result", "learn"],
        autorep: ["problem", "do", "result", "learn"],
        indusec: ["problem", "do", "result", "learn"]
      };
      return (
        <article
          class="editor-window"
          id={`proyecto-${project.id}`}
          data-open="false"
          data-palette={info.palette}
          style={`--pa: ${PALETTE_HEX[info.palette]}`}
        >
          <span class="project-index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>

          <div class="proj-media">
            <img
              src={project.image}
              alt={`Captura de ${title}`}
              loading="lazy"
              decoding="async"
              style={`view-transition-name: fx-cover-${project.slug}`}
            />
            <span class="proj-kind">{info.kind[lang]}</span>
            <a class="proj-demo" href={project.demo} target="_blank" rel="noopener noreferrer" data-track="demo_click">
              {getTranslation("projects.btn.demo", lang)} ↗
            </a>
          </div>

          <div class="proj-head">
            <div class="proj-titles">
              <h3 class="editor-title">
                <button
                  type="button"
                  class="proj-toggle"
                  aria-expanded="false"
                  aria-controls={`panel-${project.id}`}
                  data-toggle-project={project.id}
                >
                  {title}
                </button>
              </h3>
              <div class="editor-tagline">{getTranslation(`projects.${project.id}.tagline` as any, lang)}</div>
            </div>
            <div class="proj-summary">
              <div class="editor-tags proj-tags-mini">
                {project.tags.slice(0, ui.visible).map((tag) => <span class="tag">{tag}</span>)}
                {project.tags.length > ui.visible && <span class="tag tag-more">+{project.tags.length - ui.visible}</span>}
              </div>
              <span class="proj-more" aria-hidden="true">
                <span class="proj-more-label" data-more={ui.more} data-less={ui.less}>{ui.more}</span>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
              </span>
            </div>
          </div>

          <div class="proj-panel" id={`panel-${project.id}`} role="region" aria-label={title}>
            <div class="proj-panel-inner">
              <div class="editor-body">
                {info.metrics && (
                  <ul class="proj-metrics">
                    {info.metrics.map((m, mi) => (
                      <li style={`--i: ${mi}`}>
                        <strong>{m.value}</strong>
                        <span>{m.label[lang]}</span>
                      </li>
                    ))}
                  </ul>
                )}

                <div class="editor-grid">
                  {[0, 1, 2, 3].map((index) => {
                    const key = keys[project.id][index];
                    return (
                      <div class="editor-block" style={`--i: ${index + (info.metrics ? 1 : 0)}`}>
                        <h4>{getBlockLabel(project.id, index, lang)}</h4>
                        <p set:html={getTranslation(`projects.${project.id}.${key}` as any, lang)}></p>
                      </div>
                    );
                  })}
                </div>

                <div class="editor-tags proj-tags-all" style="--i: 5">
                  {project.tags.map((tag) => <span class="tag">{tag}</span>)}
                </div>

                <div class="proj-actions" style="--i: 6">
                  <a class="btn btn-primary" href={caseHref} data-track="case_click" data-track-prop-slug={project.slug}>
                    {ui.caseStudy} →
                  </a>
                  <a class="btn btn-ghost" href={project.demo} target="_blank" rel="noopener noreferrer" data-track="demo_click">
                    {getTranslation("projects.btn.demo", lang)} ↗
                  </a>
                  {project.code && (
                    <a class="btn btn-ghost" href={project.code} target="_blank" rel="noopener noreferrer" data-track="code_click">
                      {getTranslation("projects.btn.code", lang)} ↗
                    </a>
                  )}
                </div>
              </div>

              <div class="editor-terminal">
                <span class="t-prompt">$</span>
                <span>npm run status --project={project.tab.split(".")[0]}</span>
                <span class="t-val">{getTranslation(`projects.${project.id}.terminal` as any, lang)}</span>
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>

<script>
  const root = document.documentElement;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".editor-window"));
  const DEFAULT_PALETTE = "cyan";
  const DURATION = 800;

  const isOpen = (c: HTMLElement) => c.dataset.open === "true";

  function setState(card: HTMLElement, open: boolean) {
    card.dataset.open = open ? "true" : "false";
    const btn = card.querySelector<HTMLElement>(".proj-toggle");
    btn?.setAttribute("aria-expanded", String(open));
    const label = card.querySelector<HTMLElement>(".proj-more-label");
    if (label) label.textContent = open ? label.dataset.less ?? "" : label.dataset.more ?? "";
  }

  // Mantiene la tarjeta clicada quieta en pantalla mientras las demás cambian de altura,
  // y al terminar la encuadra si quedó parcialmente fuera de vista.
  function pin(card: HTMLElement, settle: boolean) {
    if (reduce) {
      if (settle) card.scrollIntoView({ block: "nearest" });
      return;
    }
    const startTop = card.getBoundingClientRect().top;
    const t0 = performance.now();
    const step = (now: number) => {
      const drift = card.getBoundingClientRect().top - startTop;
      if (Math.abs(drift) > 0.5) window.scrollBy({ top: drift, behavior: "instant" as ScrollBehavior });
      if (now - t0 < DURATION) {
        requestAnimationFrame(step);
      } else if (settle) {
        const r = card.getBoundingClientRect();
        if (r.top < 90 || r.bottom > window.innerHeight - 20) {
          window.scrollTo({ top: window.scrollY + r.top - 96, behavior: "smooth" });
        }
      }
    };
    requestAnimationFrame(step);
  }

  function open(card: HTMLElement, animate = true) {
    if (animate) pin(card, true);
    cards.forEach((c) => c !== card && isOpen(c) && setState(c, false));
    setState(card, true);
    root.dataset.palette = card.dataset.palette || DEFAULT_PALETTE;
  }

  function close(card: HTMLElement) {
    pin(card, false);
    setState(card, false);
    if (!cards.some(isOpen)) root.dataset.palette = DEFAULT_PALETTE;
  }

  function toggle(card: HTMLElement) {
    isOpen(card) ? close(card) : open(card);
  }

  cards.forEach((card) => {
    card.querySelector(".proj-toggle")?.addEventListener("click", () => toggle(card));
    // La imagen y la cabecera también abren; el enlace "Ver demo" conserva su función.
    card.querySelector(".proj-media")?.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) return;
      toggle(card);
    });
  });

  // Índice (pestañas): abre la tarjeta en lugar de saltar a otra página.
  document.querySelectorAll<HTMLAnchorElement>("[data-open-project]").forEach((tab) => {
    tab.addEventListener("click", (e) => {
      const card = document.getElementById(`proyecto-${tab.dataset.openProject}`);
      if (!card) return;
      e.preventDefault();
      history.replaceState(null, "", `#proyecto-${tab.dataset.openProject}`);
      if (!isOpen(card)) open(card);
      else card.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
    });
  });

  // Enlace directo: /#proyecto-fibog
  const fromHash = () => {
    const card = location.hash.startsWith("#proyecto-") ? document.getElementById(location.hash.slice(1)) : null;
    if (card && cards.includes(card)) {
      open(card, false);
      requestAnimationFrame(() => card.scrollIntoView({ block: "start" }));
    }
  };
  fromHash();
  window.addEventListener("hashchange", fromHash);
</script>

<style>
  section {
    padding: 96px 0;
  }

  .section-head {
    margin-bottom: 48px;
  }

  .eyebrow {
    color: var(--accent-text);
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 14px;
    opacity: 0.8;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-bottom: 16px;
  }

  .section-sub {
    color: var(--muted);
    max-width: 650px;
    line-height: 1.7;
    font-size: 1.05rem;
  }

  /* ───────── Tarjeta de proyecto ───────── */
  .editor-window {
    --open-ease: cubic-bezier(0.16, 1, 0.3, 1);
    background: var(--glass-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    margin-bottom: 22px;
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-shadow);
    transition:
      transform 0.5s var(--open-ease),
      border-color 0.5s var(--open-ease),
      box-shadow 0.6s var(--open-ease);
    position: relative;
    scroll-margin-top: 96px;
  }

  .editor-window::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45), transparent);
    pointer-events: none;
    z-index: 2;
  }

  .editor-window:hover {
    border-color: color-mix(in srgb, var(--pa) 45%, transparent);
    box-shadow: var(--glass-shadow-hover);
    transform: translateY(-3px);
  }

  .editor-window[data-open="true"] {
    transform: none;
    border-color: color-mix(in srgb, var(--pa) 55%, transparent);
    box-shadow:
      var(--glass-shadow),
      0 0 0 1px color-mix(in srgb, var(--pa) 22%, transparent),
      0 40px 90px -40px color-mix(in srgb, var(--pa) 60%, transparent);
  }

  .project-index {
    position: absolute;
    top: 6px;
    right: 20px;
    z-index: 4;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.4rem, 7vw, 5.2rem);
    letter-spacing: -0.05em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.55);
    opacity: 0.9;
    pointer-events: none;
    transition: -webkit-text-stroke-color 0.4s var(--ease);
  }

  .editor-window:hover .project-index,
  .editor-window[data-open="true"] .project-index {
    -webkit-text-stroke-color: var(--pa);
  }

  /* ── Imagen: banner compacto que se abre al desplegar ── */
  .proj-media {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    aspect-ratio: 16 / 3.9;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
    transition: aspect-ratio 0.9s var(--open-ease);
  }

  .proj-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
    transition:
      transform 0.9s var(--open-ease),
      object-position 1.4s var(--open-ease),
      filter 0.6s var(--ease);
  }

  .proj-media::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to top, color-mix(in srgb, var(--bg) 60%, transparent), transparent 55%),
      linear-gradient(120deg, color-mix(in srgb, var(--pa) 22%, transparent), transparent 45%);
    opacity: 1;
    transition: opacity 0.8s var(--ease);
  }

  .editor-window:hover .proj-media img { transform: scale(1.035); filter: saturate(1.12); }

  .editor-window[data-open="true"] .proj-media { aspect-ratio: 16 / 7; cursor: default; }
  .editor-window[data-open="true"] .proj-media img { transform: scale(1); object-position: 50% 22%; }
  .editor-window[data-open="true"] .proj-media::after { opacity: 0.45; }

  .proj-kind {
    position: absolute;
    left: 18px;
    top: 16px;
    z-index: 3;
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    color: #fff;
    background: color-mix(in srgb, var(--pa) 55%, rgba(8, 12, 20, 0.55));
    border: 1px solid color-mix(in srgb, var(--pa) 70%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .proj-demo {
    position: absolute;
    right: 18px;
    bottom: 14px;
    z-index: 3;
    padding: 8px 16px;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-full);
    background: var(--glass-card-strong);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--white);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 600;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .proj-demo:hover { transform: translateY(-2px); border-color: var(--pa); }

  /* ── Cabecera (siempre visible) ── */
  .proj-head {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 28px;
    padding: 22px 28px 24px;
  }

  .editor-title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    margin-bottom: 6px;
  }

  .proj-toggle {
    all: unset;
    cursor: pointer;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-wrap: balance;
  }
  /* toda la cabecera es zona de clic */
  .proj-toggle::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .proj-toggle:focus-visible { outline: none; }
  .proj-toggle:focus-visible::after {
    outline: 2px solid var(--pa);
    outline-offset: -3px;
    border-radius: var(--radius);
  }

  .editor-tagline {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--accent-text);
    max-width: 56ch;
    line-height: 1.55;
  }

  .proj-summary {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .proj-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--white);
    padding: 9px 16px;
    border-radius: var(--radius-full);
    border: 1px solid color-mix(in srgb, var(--pa) 50%, transparent);
    background: color-mix(in srgb, var(--pa) 12%, transparent);
    transition: background 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .editor-window:hover .proj-more { background: color-mix(in srgb, var(--pa) 22%, transparent); }
  .proj-more svg { transition: transform 0.6s var(--open-ease); }
  .editor-window[data-open="true"] .proj-more svg { transform: rotate(180deg); }

  /* mini-tags: se esconden al abrir (el panel muestra todas) */
  .proj-tags-mini {
    margin: 0;
    padding: 0;
    transition: opacity 0.4s var(--ease);
  }
  .editor-window[data-open="true"] .proj-tags-mini { opacity: 0; }
  .tag-more { opacity: 0.7; }

  /* ── Panel desplegable: 0fr → 1fr (altura real, sin números mágicos) ── */
  .proj-panel {
    display: grid;
    grid-template-rows: 1fr;
  }
  .proj-panel-inner { min-height: 0; overflow: hidden; }

  html.js .proj-panel {
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.9s var(--open-ease);
  }
  html.js .editor-window[data-open="true"] .proj-panel { grid-template-rows: 1fr; }

  /* cerrado: fuera del orden de tabulación una vez termina la animación */
  html.js .editor-window[data-open="false"] .proj-panel-inner {
    visibility: hidden;
    transition: visibility 0s linear 0.9s;
  }

  .editor-body { padding: 4px 28px 28px; }

  /* Métricas */
  .proj-metrics {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 8px 0 20px;
  }
  .proj-metrics li {
    display: grid;
    gap: 2px;
    padding: 12px 18px;
    border-radius: var(--radius);
    border: 1px solid color-mix(in srgb, var(--pa) 35%, transparent);
    background: color-mix(in srgb, var(--pa) 9%, transparent);
  }
  .proj-metrics strong {
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--white);
  }
  .proj-metrics span { color: var(--muted); font-size: 0.78rem; max-width: 22ch; line-height: 1.4; }

  .editor-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .editor-block {
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 2px solid color-mix(in srgb, var(--pa) 70%, transparent);
    border-radius: var(--radius-sm);
    padding: 16px 18px;
    transition:
      border-color 0.2s var(--ease),
      background 0.2s var(--ease),
      opacity 0.7s var(--open-ease),
      transform 0.8s var(--open-ease);
  }
  .editor-block:hover { border-color: var(--line-strong); border-left-color: var(--pa); background: var(--surface-hover); }

  .editor-block h4 {
    font-family: var(--mono);
    font-size: 0.72rem;
