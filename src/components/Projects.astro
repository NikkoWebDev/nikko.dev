---
import { getTranslation, type Lang } from "../data/translations";

export interface Props {
  lang?: Lang;
}

const { lang = "es" } = Astro.props;

const projects = [
  {
    id: "fibog",
    tab: "FIBOG.tsx",
    demo: "https://semilleros-fibog.vercel.app",
    code: "https://github.com/NikkoWebDev/FIBOG",
    tags: ["Astro", "Supabase", "PostgreSQL", "RLS", "Accesibilidad", "UNAL"]
  },
  {
    id: "sinpre",
    tab: "SinPresupuesto.ts",
    demo: "https://sinpresupuesto.com",
    code: "https://github.com/SinPresupuesto/SinPre",
    tags: ["Next.js", "Cloudflare Workers", "Supabase", "Llama 3.1", "OAuth", "PWA"]
  },
  {
    id: "autorep",
    tab: "Autorreparacion.astro",
    demo: "https://www.autorreparacion.com",
    code: null,
    tags: ["Astro", "GSAP", "SEO", "Responsive", "Cliente real"]
  },
  {
    id: "indusec",
    tab: "InduSEC.astro",
    demo: "https://puertasindusec.com",
    code: "https://github.com/NikkoWebDev/induSEC-WEB",
    tags: ["Astro", "SEO", "Responsive", "Cliente real"]
  }
] as const;

const labels = {
  es: {
    problem: "El problema",
    do: "Qué hice",
    stack: "¿Por qué ese stack?",
    result: "Resultado",
    learnFibog: "Lo que aprendí",
    learnSinpre: "Lo que haría diferente",
    learnAuto: "Lo que aprendería",
    learnIndu: "Lo que aprendería"
  },
  en: {
    problem: "The problem",
    do: "What I did",
    stack: "Why that stack?",
    result: "Result",
    learnFibog: "What I learned",
    learnSinpre: "What I'd do differently",
    learnAuto: "What I'd learn next",
    learnIndu: "What I'd learn next"
  }
};

function getBlockLabel(id: string, index: number, lang: Lang): string {
  const l = labels[lang];
  if (index === 0) return l.problem;
  if (index === 1) return l.do;
  if (index === 2) {
    if (id === "fibog") return l.stack;
    return l.result;
  }
  if (id === "fibog") return l.learnFibog;
  if (id === "sinpre") return l.learnSinpre;
  if (id === "autorep") return l.learnAuto;
  return l.learnIndu;
}
---

<section id="proyectos">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">{getTranslation("projects.eyebrow", lang)}</div>
      <h2>{getTranslation("projects.title", lang)}</h2>
      <p class="section-sub">{getTranslation("projects.sub", lang)}</p>
    </div>

    {projects.map((project) => (
      <article class="editor-window">
        <div class="editor-tabs">
          {projects.map((p) => (
            <div class={`editor-tab ${p.id === project.id ? "active" : ""}`}>
              {p.id === project.id && <span class="editor-tab-icon">◆</span>}
              {p.tab}
            </div>
          ))}
        </div>

        <div class="editor-body">
          <div class="editor-meta">
            <div>
              <h3 class="editor-title">{getTranslation(`projects.${project.id}.title` as any, lang)}</h3>
              <div class="editor-tagline">{getTranslation(`projects.${project.id}.tagline` as any, lang)}</div>
            </div>
            <div class="editor-links">
              <a href={project.demo} target="_blank" rel="noopener noreferrer">
                {getTranslation("projects.btn.demo", lang)} ↗
              </a>
              {project.code && (
                <a href={project.code} target="_blank" rel="noopener noreferrer">
                  {getTranslation("projects.btn.code", lang)} ↗
                </a>
              )}
            </div>
          </div>

          <div class="editor-grid">
            {[0, 1, 2, 3].map((index) => {
              const keys: Record<string, string[]> = {
                fibog: ["problem", "do", "stack", "learn"],
                sinpre: ["problem", "do", "result", "learn"],
                autorep: ["problem", "do", "result", "learn"],
                indusec: ["problem", "do", "result", "learn"]
              };
              const key = keys[project.id][index];
              return (
                <div class="editor-block">
                  <h4>{getBlockLabel(project.id, index, lang)}</h4>
                  <p set:html={getTranslation(`projects.${project.id}.${key}` as any, lang)}></p>
                </div>
              );
            })}
          </div>

          <div class="editor-tags">
            {project.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>

        <div class="editor-terminal">
          <span class="t-prompt">$</span>
          <span>npm run status --project={project.tab.split(".")[0]}</span>
          <span class="t-val">{getTranslation(`projects.${project.id}.terminal` as any, lang)}</span>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  section {
    padding: 96px 0;
  }

  .section-head {
    margin-bottom: 48px;
  }

  .eyebrow {
    color: var(--green);
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 14px;
    opacity: 0.8;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-bottom: 16px;
  }

  .section-sub {
    color: var(--muted);
    max-width: 650px;
    line-height: 1.7;
    font-size: 1.05rem;
  }

  .editor-window {
    background: rgba(255,255,255,0.64);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    border: 1px solid rgba(16,185,129,0.14);
    border-radius: 18px;
    overflow: hidden;
    margin-bottom: 28px;
    transition: all 0.3s var(--ease);
    box-shadow: 0 8px 32px rgba(16,185,129,0.08), 0 1px 3px rgba(0,0,0,0.04);
  }

  .editor-window:hover {
    border-color: rgba(16,185,129,0.22);
    box-shadow: 0 12px 40px rgba(16,185,129,0.14), 0 4px 12px rgba(0,0,0,0.06);
    transform: translateY(-2px);
    background: rgba(255,255,255,0.76);
  }

  .editor-tabs {
    display: flex;
    flex-wrap: nowrap;
    gap: 6px;
    background: rgba(255,255,255,0.48);
    border: 1px solid rgba(16,185,129,0.12);
    border-radius: 999px;
    padding: 6px;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .editor-tabs::-webkit-scrollbar { display: none; }

  .editor-tab {
    padding: 8px 14px;
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--muted);
    border: 1px solid transparent;
    border-radius: 999px;
    display: flex;
    align-items: center;
    gap: 7px;
    white-space: nowrap;
    flex: 0 0 auto;
    transition: all 0.2s var(--ease);
  }

  .editor-tab.active {
    background: #022C22;
    color: #ECFDF5;
    border-color: #022C22;
    font-weight: 600;
    box-shadow: 0 4px 14px rgba(2,44,34,0.12);
  }

  .editor-tab-icon {
    color: var(--cyan);
    font-size: 0.7rem;
  }

  .editor-body {
    padding: 28px;
  }

  .editor-meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 20px;
  }

  .editor-title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 6px;
  }

  .editor-tagline {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--green);
  }

  .editor-links {
    display: flex;
    gap: 16px;
  }

  .editor-links a {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--cyan);
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.2s;
  }

  .editor-links a:hover {
    opacity: 0.7;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 24px;
  }

  .editor-block h4 {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--cyan);
    margin-bottom: 8px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .editor-block h4::before {
    content: "// ";
    color: rgba(139, 139, 150, 0.5);
  }

  .editor-block p {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .editor-block p strong {
    color: var(--white);
    font-weight: 600;
  }

  .editor-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
    padding-top: 4px;
  }

  .editor-tags .tag {
    font-family: var(--mono);
    font-size: 0.72rem;
    padding: 6px 12px;
    background: rgba(16,185,129, 0.06);
    border: 1px solid rgba(16,185,129, 0.12);
    border-radius: var(--radius-full);
    color: var(--green);
    transition: all 0.2s;
  }

  .editor-tags .tag:hover {
    background: rgba(16,185,129, 0.12);
    box-shadow: 0 0 10px rgba(16,185,129, 0.1);
    transform: translateY(-1px);
  }

  .editor-terminal {
    background: var(--bg-2);
    border-top: 1px solid var(--line);
    padding: 12px 24px;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .editor-terminal .t-prompt { color: var(--green); }
  .editor-terminal .t-val { color: var(--cyan); }

  @media (max-width: 860px) {
    .editor-body {
      padding: 22px;
    }

    .editor-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .editor-meta {
      flex-direction: column;
      gap: 14px;
    }

    .editor-links {
      width: 100%;
    }

    .editor-terminal {
      gap: 6px;
      font-size: 0.68rem;
      padding: 12px 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .editor-window {
      transition: none;
    }
  }
</style>
