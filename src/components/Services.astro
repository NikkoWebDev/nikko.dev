---
import { getTranslation, type Lang } from "../data/translations";
export interface Props { lang?: Lang; }
const { lang = "es" } = Astro.props;
---

<section id="servicios" class="section-bg-mesh">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">{getTranslation("services.eyebrow", lang)}</div>
      <h2 class="display-sm">{getTranslation("services.title", lang)}</h2>
      <p class="section-sub section-sub-wide">
        {getTranslation("services.sub", lang)}
      </p>
    </div>

    <div class="serv-grid">
      <article class="serv-card">
        <div class="serv-header">
          <span class="serv-number">01</span>
          <span class="serv-tag">Architecture</span>
        </div>
        <h3>{getTranslation("services.card1.title", lang)}</h3>
        <p>{getTranslation("services.card1.desc", lang)}</p>
        <div class="serv-tags">
          <span class="tag">Next.js / Astro</span>
          <span class="tag">Cloudflare Edge</span>
          <span class="tag">Supabase</span>
          <span class="tag">PostgreSQL RLS</span>
        </div>
      </article>

      <article class="serv-card">
        <div class="serv-header">
          <span class="serv-number">02</span>
          <span class="serv-tag">Applied AI</span>
        </div>
        <h3>{getTranslation("services.card2.title", lang)}</h3>
        <p>{getTranslation("services.card2.desc", lang)}</p>
        <div class="serv-tags">
          <span class="tag">FastAPI</span>
          <span class="tag">Python RAG</span>
          <span class="tag">Vector Search</span>
          <span class="tag">Webhooks</span>
        </div>
      </article>

      <article class="serv-card">
        <div class="serv-header">
          <span class="serv-number">03</span>
          <span class="serv-tag">Performance</span>
        </div>
        <h3>{getTranslation("services.card3.title", lang)}</h3>
        <p>{getTranslation("services.card3.desc", lang)}</p>
        <div class="serv-tags">
          <span class="tag tag-amber">Core Web Vitals</span>
          <span class="tag tag-amber">Latencia 0.2s</span>
          <span class="tag">Zero Infra Cost</span>
          <span class="tag">Astro SSG</span>
        </div>
      </article>

      <article class="serv-card">
        <div class="serv-header">
          <span class="serv-number">04</span>
          <span class="serv-tag">Product Engineering</span>
        </div>
        <h3>{getTranslation("services.card4.title", lang)}</h3>
        <p>{getTranslation("services.card4.desc", lang)}</p>
        <div class="serv-tags">
          <span class="tag">PWA Offline</span>
          <span class="tag">SEO Técnico</span>
          <span class="tag">Interactive UI</span>
          <span class="tag">Alta Conversión</span>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .serv-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .serv-card {
    background: var(--glass-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    padding: 34px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-shadow);
    position: relative;
    overflow: hidden;
    transition: all 0.3s var(--ease);
  }

  .serv-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
    pointer-events: none;
  }

  .serv-card:hover {
    border-color: var(--line-green);
    background: var(--glass-card-hover);
    transform: translateY(-4px);
    box-shadow: var(--glass-shadow-hover);
  }

  .serv-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .serv-number {
    font-family: var(--mono);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--accent-text);
  }

  .serv-tag {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .serv-card h3 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--white);
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .serv-card p {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.65;
    flex-grow: 1;
  }

  .serv-tags {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    font-family: var(--mono);
    font-size: 0.72rem;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--white);
    backdrop-filter: blur(8px);
    transition: all 0.2s var(--ease);
  }

  .tag:hover {
    border-color: var(--line-green);
    color: var(--accent-text);
  }

  .tag-amber {
    color: var(--amber-text);
    border-color: var(--line-amber);
  }

  @media (max-width: 860px) {
    .serv-grid { grid-template-columns: 1fr; }
    .serv-card { padding: 26px; }
  }
</style>
