---
import SectionHeading from "./SectionHeading.astro";
import { metrics } from "../data/content";
import { getProject } from "../data/projects";
import { projectPath, useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const items = metrics.map((metric) => {
  if ("project" in metric.source) {
    const project = getProject(metric.source.project);
    if (!project) throw new Error(`[metrics] Proyecto desconocido: ${metric.source.project}`);
    return { ...metric, sourceName: project.name, sourceHref: projectPath(project.slug, lang), external: false };
  }
  return { ...metric, sourceName: metric.source.name, sourceHref: metric.source.href, external: true };
});
---

<section class="section metrics" id="metricas" aria-labelledby="metricas-title">
  <div class="container">
    <SectionHeading id="metricas-title" index="02" eyebrow={t("metrics.eyebrow")} title={t("metrics.title")} sub={t("metrics.sub")} />
    <ul class="metric-grid" role="list">
      {items.map((metric) => (
        <li class={metric.id === "speed" ? "metric metric-lead" : "metric"} data-spotlight data-reveal>
          <p class="metric-value" data-count-to={metric.count?.to} data-count-suffix={metric.count?.suffix}>{metric.value}</p>
          <p class="metric-label">{t(metric.labelKey)}</p>
          <a class="metric-source" href={metric.sourceHref} target={metric.external ? "_blank" : undefined} rel={metric.external ? "noopener noreferrer" : undefined}>
            <span class="metric-source-key">{t("metrics.source")}</span> {metric.sourceName} <span aria-hidden="true">{metric.external ? "↗" : "→"}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .metric-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: 26px 26px 22px;
    border-radius: var(--radius-l);
    border: 1px solid var(--border);
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    box-shadow: var(--shadow-1);
    transition: border-color 0.3s var(--ease);
  }

  .metric:hover {
    border-color: var(--border-accent);
  }

  .metric-lead {
    border-color: rgba(var(--accent-rgb), 0.28);
    background:
      radial-gradient(420px 220px at 0% 0%, rgba(var(--accent-rgb), 0.16), transparent 70%),
      linear-gradient(180deg, var(--surface-2), var(--surface));
  }

  .metric-value {
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 1.8rem + 1.8vw, 3.4rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }

  .metric-lead .metric-value {
    color: var(--accent-text);
  }

  .metric-label {
    color: var(--text-2);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .metric-source {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    transition: color 0.2s var(--ease);
  }

  .metric-source:hover {
    color: var(--accent-text);
  }

  .metric-source-key {
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.66rem;
    margin-right: 4px;
  }

  @media (max-width: 960px) {
    .metric-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .metric-grid {
      gap: 12px;
    }

    .metric {
      padding: 20px 18px 18px;
    }

    .metric-lead {
      grid-column: 1 / -1;
    }

    .metric-value {
      font-size: 2rem;
    }
  }
</style>
