---
import { getTranslation, type Lang } from "../data/translations";
export interface Props { lang?: Lang; }
const { lang = "es" } = Astro.props;
---

<section id="metricas" class="section-bg-grid">
  <div class="container">
    <!-- Compact head — different from other sections -->
    <div class="section-head-compact">
      <div class="eyebrow">{getTranslation("metrics.eyebrow", lang)}</div>
      <h2 class="display-sm">{getTranslation("metrics.title", lang)}</h2>
    </div>

    <div class="dash-grid">
      <!-- Featured metric: 8+ projects (larger, green accent) -->
      <div class="dash-card dash-featured">
        <div class="dash-label">PROYECTOS</div>
        <div class="dash-value">
          <span class="dash-num" data-count="8">0</span>
          <span class="dash-plus">+</span>
        </div>
        <div class="dash-unit">{getTranslation("metrics.projects", lang)}</div>
        <div class="dash-bar">
          <span style="width:80%"></span>
        </div>
      </div>

      <!-- Metric: 13 groups -->
      <div class="dash-card">
        <div class="dash-label">GRUPOS</div>
        <div class="dash-value sm">
          <span class="dash-num">13</span>
        </div>
        <div class="dash-unit">{getTranslation("metrics.groups", lang)}</div>
      </div>

      <!-- Metric: 3s→0.2s (featured) -->
      <div class="dash-card dash-accent">
        <div class="dash-label">OPTIMIZACIÓN</div>
        <div class="dash-value md">
          <span class="dash-num-accent">3s</span>
          <span class="dash-arrow">→</span>
          <span class="dash-num-accent highlight">0.2s</span>
        </div>
        <div class="dash-unit">{getTranslation("metrics.optimization", lang)}</div>
        <div class="dash-gauge">
          <span class="dash-gauge-fill" style="width:93%"></span>
          <span class="dash-gauge-label">93% faster</span>
        </div>
      </div>

      <!-- Metric: 11k+ lines -->
      <div class="dash-card">
        <div class="dash-label">CÓDIGO</div>
        <div class="dash-value sm">
          <span class="dash-num">11k+</span>
        </div>
        <div class="dash-unit">{getTranslation("metrics.lines", lang)}</div>
      </div>

      <!-- Metric: 2 platforms (small) -->
      <div class="dash-card dash-sm">
        <div class="dash-label">PRODUCCIÓN</div>
        <div class="dash-value xs">
          <span class="dash-num">2</span>
        </div>
        <div class="dash-unit">{getTranslation("metrics.platforms", lang)}</div>
      </div>

      <!-- Metric: ~$0 cost -->
      <div class="dash-card dash-sm">
        <div class="dash-label">COSTO</div>
        <div class="dash-value xs">
          <span class="dash-num" style="color:var(--cyan);">~$0</span>
        </div>
        <div class="dash-unit">{getTranslation("metrics.cost", lang)}</div>
      </div>

      <!-- Metric: 2 years -->
      <div class="dash-card dash-sm">
        <div class="dash-label">EXPERIENCIA</div>
        <div class="dash-value xs">
          <span class="dash-num">2</span>
        </div>
        <div class="dash-unit">{getTranslation("metrics.exp", lang)}</div>
      </div>

      <!-- Metric: B2 English -->
      <div class="dash-card dash-sm">
        <div class="dash-label">INGLÉS</div>
        <div class="dash-value xs">
          <span class="dash-num" style="color:var(--amber);">B2</span>
        </div>
        <div class="dash-unit">{getTranslation("metrics.english", lang)}</div>
      </div>
    </div>

    <!-- Terminal log line -->
    <div class="term-log" style="margin-top:28px;">
      <span class="log-time">[metrics]</span>
      <span>$ dashboard —live —fps=60 —optimized</span>
    </div>
  </div>
</section>

<style>
  .dash-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: auto auto;
    gap: 18px;
  }

  /* ── Featured (spans 2 cols) ── */
  .dash-featured {
    grid-column: span 2;
    grid-row: span 1;
  }

  /* ── Accent (spans 2 cols) ── */
  .dash-accent {
    grid-column: span 2;
  }

  /* ── Small cards ── */
  .dash-sm {
    /* stays in flow */
  }

  /* ── Card base ── */
  .dash-card {
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 24px;
    background: var(--glass-card);
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease);
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .dash-card:hover {
    border-color: var(--line-green);
    background: var(--glass-card-hover);
  }

  .dash-featured {
    background: linear-gradient(160deg, var(--bg-glow-1), var(--glass-card));
    border-color: var(--line-green);
  }

  .dash-accent {
    background: linear-gradient(160deg, var(--bg-glow-2), var(--glass-card));
  }

  /* ── Label ── */
  .dash-label {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    opacity: 0.7;
  }

  /* ── Value ── */
  .dash-value {
    margin: 4px 0;
  }

  .dash-num {
    font-family: var(--font-display);
    font-size: 2.8rem;
    font-weight: 900;
    color: var(--green);
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .dash-num-accent {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    color: var(--white);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .dash-num-accent.highlight {
    color: var(--cyan);
    font-size: 2.4rem;
  }

  .dash-plus {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--green);
    opacity: 0.5;
    margin-left: 2px;
  }

  .dash-arrow {
    font-family: var(--mono);
    font-size: 1.4rem;
    color: var(--muted);
    margin: 0 6px;
    opacity: 0.5;
  }

  .dash-value.sm .dash-num { font-size: 2rem; }
  .dash-value.md { display: flex; align-items: baseline; }
  .dash-value.xs .dash-num { font-size: 1.6rem; }

  /* ── Unit ── */
  .dash-unit {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.4;
  }

  /* ── Bar (featured) ── */
  .dash-bar {
    margin-top: 8px;
    height: 4px;
    background: var(--surface-2);
    border-radius: 2px;
    overflow: hidden;
  }

  .dash-bar span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--green), var(--cyan));
    border-radius: 2px;
  }

  /* ── Gauge (accent) ── */
  .dash-gauge {
    position: relative;
    margin-top: 8px;
    height: 4px;
    background: var(--surface-2);
    border-radius: 2px;
    overflow: visible;
  }

  .dash-gauge-fill {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--cyan), var(--green));
    border-radius: 2px;
    position: relative;
  }

  .dash-gauge-label {
    position: absolute;
    right: 0;
    top: -16px;
    font-family: var(--mono);
    font-size: 0.65rem;
    color: var(--green);
  }

  @media (max-width: 1024px) {
    .dash-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .dash-featured,
    .dash-accent { grid-column: span 2; }
    .dash-card { padding: 22px; }
  }

  @media (max-width: 640px) {
    .dash-grid { grid-template-columns: 1fr; gap: 14px; }
    .dash-featured,
    .dash-accent { grid-column: span 1; }
    .dash-card { padding: 20px; }
    .dash-num { font-size: 2rem; }
    .dash-value.sm .dash-num { font-size: 1.6rem; }
  }
</style>
