---
import SectionHeading from "./SectionHeading.astro";
import { CONTACT, whatsappLink } from "../data/site";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const wa = whatsappLink(t("wa.message"));

const channels = [
  { id: "whatsapp", via: "whatsapp", detail: CONTACT.whatsappDisplay, desc: t("contact.whatsapp.desc"), href: wa, external: true, track: "whatsapp_click" },
  { id: "email", via: "email", detail: CONTACT.email, desc: t("contact.email.desc"), href: `mailto:${CONTACT.email}`, external: false, track: "email_click" },
  { id: "github", via: "github", detail: `@${CONTACT.githubHandle}`, desc: t("contact.github.desc"), href: CONTACT.github, external: true, track: "social_click" },
  { id: "linkedin", via: "linkedin", detail: "Nikolas Gallo", desc: t("contact.linkedin.desc"), href: CONTACT.linkedin, external: true, track: "social_click" },
];
---

<section class="section contact" id="contacto" aria-labelledby="contacto-title">
  <div class="container">
    <div class="contact-panel" data-spotlight data-reveal>
      <div class="contact-copy">
        <SectionHeading id="contacto-title" index="07" eyebrow={t("contact.eyebrow")} title={t("contact.title")} sub={t("contact.desc")} />
        <p class="contact-status"><span class="dot dot-pulse" aria-hidden="true"></span>{t("contact.available")}</p>
        <div class="contact-actions">
          <a class="btn btn-primary btn-lg" href={wa} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-track-prop-place="contact">{t("hero.cta.whatsapp")}</a>
          <button class="btn btn-ghost btn-lg" type="button" data-copy={CONTACT.email} data-copy-success={t("toast.copied")} data-copy-error={t("toast.copyError")} aria-label={t("contact.copyLabel")}>
            <span class="contact-at" aria-hidden="true">@</span>
            {t("contact.copy")} email
          </button>
        </div>
      </div>

      <div class="contact-shell">
        <p class="contact-shell-head"><span class="contact-prompt" aria-hidden="true">$</span> contact --list</p>
        <ul class="contact-list" role="list">
          {channels.map((channel) => (
            <li>
              <a class="contact-row" href={channel.href} target={channel.external ? "_blank" : undefined} rel={channel.external ? "noopener noreferrer" : undefined} data-track={channel.track} data-track-prop-channel={channel.id}>
                <span class="contact-via"><span class="contact-flag">--via</span> {channel.via}</span>
                <span class="contact-detail">{channel.detail}</span>
                <span class="contact-desc">{channel.desc}</span>
                <span class="contact-arrow" aria-hidden="true">{channel.external ? "↗" : "→"}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(28px, 5vw, 64px);
    padding: clamp(28px, 5vw, 56px);
    overflow: hidden;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-2);
    background:
      radial-gradient(640px 360px at 0% 0%, rgba(var(--accent-rgb), 0.16), transparent 65%),
      radial-gradient(520px 320px at 100% 100%, rgba(var(--aqua-rgb), 0.08), transparent 65%),
      var(--glass);
    box-shadow: var(--shadow-2);
  }

  .contact-copy :global(.sh) {
    margin-bottom: 22px;
  }

  .contact-status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .contact-at {
    color: var(--accent-text);
    font-family: var(--font-mono);
  }

  .contact-shell {
    overflow: hidden;
    border-radius: var(--radius-l);
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    font-family: var(--font-mono);
  }

  .contact-shell-head {
    padding: 12px 18px;
    border-bottom: 1px solid var(--border);
    color: var(--text-3);
    font-size: 0.76rem;
  }

  .contact-prompt {
    color: var(--accent-text);
  }

  .contact-list {
    display: grid;
    padding: 8px;
  }

  .contact-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "via arrow"
      "detail arrow"
      "desc arrow";
    align-items: center;
    column-gap: 16px;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid transparent;
    font-size: 0.82rem;
    transition:
      background-color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .contact-row:hover {
    background: var(--surface-2);
    border-color: var(--border);
  }

  .contact-via {
    grid-area: via;
    color: var(--text);
    font-weight: 600;
  }

  .contact-flag {
    color: var(--aqua-text);
    font-weight: 400;
  }

  .contact-detail {
    grid-area: detail;
    overflow: hidden;
    color: var(--accent-text);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .contact-desc {
    grid-area: desc;
    color: var(--text-3);
    font-family: var(--font-sans);
    font-size: 0.8rem;
  }

  .contact-arrow {
    grid-area: arrow;
    color: var(--text-3);
    font-size: 1rem;
    transition:
      color 0.2s var(--ease),
      translate 0.2s var(--ease);
  }

  .contact-row:hover .contact-arrow {
    color: var(--accent-text);
    translate: 2px -2px;
  }

  @media (max-width: 960px) {
    .contact-panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 480px) {
    .contact-actions .btn {
      width: 100%;
    }
  }
</style>
