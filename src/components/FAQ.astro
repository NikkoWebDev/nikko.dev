---
import { getTranslation, type Lang } from "../data/translations";
export interface Props { lang?: Lang; }
const { lang = "es" } = Astro.props;
---

<section id="faq" class="section-bg-mesh">
  <div class="container">
    <div class="section-head" style="margin-bottom:28px;">
      <div class="eyebrow">{getTranslation("faq.eyebrow", lang)}</div>
      <h2 class="display-sm">{getTranslation("faq.title", lang)}</h2>
    </div>

    <div class="faq-list">
      <details class="faq-item" open>
        <summary>
          <span class="faq-qmark">?</span>
          {getTranslation("faq.q1", lang)}
        </summary>
        <div class="faq-answer">
          <p>{getTranslation("faq.a1", lang)}</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>
          <span class="faq-qmark">?</span>
          {getTranslation("faq.q2", lang)}
        </summary>
        <div class="faq-answer">
          <p>{getTranslation("faq.a2", lang)}</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>
          <span class="faq-qmark">?</span>
          {getTranslation("faq.q3", lang)}
        </summary>
        <div class="faq-answer">
          <p>{getTranslation("faq.a3", lang)}</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>
          <span class="faq-qmark">?</span>
          {getTranslation("faq.q4", lang)}
        </summary>
        <div class="faq-answer">
          <p>{getTranslation("faq.a4", lang)}</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>
          <span class="faq-qmark">?</span>
          {getTranslation("faq.q5", lang)}
        </summary>
        <div class="faq-answer">
          <p>{getTranslation("faq.a5", lang)}</p>
        </div>
      </details>

      <details class="faq-item">
        <summary>
          <span class="faq-qmark">?</span>
          {getTranslation("faq.q6", lang)}
        </summary>
        <div class="faq-answer">
          <p>{getTranslation("faq.a6", lang)}</p>
        </div>
      </details>
    </div>

    <!-- Terminal logging -->
    <div class="term-log" style="margin-top:28px;">
      <span class="log-time">[help]</span>
      <span>$ man nikkodev --questions --answers</span>
    </div>
  </div>
</section>

<style>
  .faq-list {
    display: grid;
    gap: 12px;
    max-width: 820px;
    margin: 0 auto;
  }

  .faq-item {
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--glass-card);
    overflow: hidden;
    transition: border-color 0.3s var(--ease);
  }

  .faq-item[open] {
    border-color: var(--line-green);
    background: rgba(0,208,132,0.02);
  }

  summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 18px 22px;
    display: flex;
    align-items: center;
    gap: 14px;
    user-select: none;
    list-style: none;
  }

  summary::-webkit-details-marker { display: none; }

  .faq-qmark {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(0,208,132,0.08);
    border: 1px solid var(--line-green);
    color: var(--green);
    font-family: var(--mono);
    font-size: 0.82rem;
    flex-shrink: 0;
    transition: background 0.3s var(--ease);
  }

  .faq-item[open] .faq-qmark {
    background: rgba(0,208,132,0.15);
  }

  summary::after {
    content: "+";
    margin-left: auto;
    font-family: var(--mono);
    font-size: 1.2rem;
    color: var(--muted);
    opacity: 0.5;
    transition: transform 0.3s var(--ease);
  }

  .faq-item[open] summary::after {
    content: "−";
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 22px 18px 64px;
  }

  .faq-answer p {
    color: var(--muted);
    line-height: 1.7;
    font-size: 0.9rem;
    margin: 0;
  }

  @media (max-width: 640px) {
    summary { padding: 16px 18px; }
    .faq-answer { padding: 0 18px 16px 18px; }
  }
</style>
